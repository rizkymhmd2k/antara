---
import ScreenWidth from "../components/ui/ScreenWidth.astro";
import "lenis/dist/lenis.css";
import "../styles/global.css";
import faviconSvgUrl from "../assets/favicon.svg?url";
import faviconIcoUrl from "../assets/favicon.ico?url";

const { class: className = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={faviconSvgUrl} />
		<link rel="icon" href={faviconIcoUrl} />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<ScreenWidth />
		<main class={className}>
			<slot />
		</main>
	</body>
</html>

<script>
	import Lenis from "lenis";

	if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const lenis = new Lenis({
			autoRaf: true,
			anchors: true,
			lerp: 0.08,
			wheelMultiplier: 0.9,
			touchMultiplier: 1.2,
		});

		window.lenis = lenis;
	}
</script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
