---
import { ClientRouter } from "astro:transitions";
import ScreenWidth from "../components/ui/ScreenWidth.astro";
import "lenis/dist/lenis.css";
import "../styles/global.css";
import faviconSvgUrl from "../assets/favicon.svg?url";
import faviconIcoUrl from "../assets/favicon.ico?url";

const { class: className = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={faviconSvgUrl} />
		<link rel="icon" href={faviconIcoUrl} />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
		<ClientRouter />
	</head>
	<body>
		<!-- <ScreenWidth /> -->
		<main class={className}>
			<slot />
		</main>
		<div class="page-transition" data-page-transition transition:persist aria-hidden="true">
			<span></span>
			<span></span>
			<span></span>
		</div>
	</body>
</html>

<script>
	import Lenis from "lenis";

	if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const lenis = new Lenis({
			autoRaf: true,
			anchors: true,
			lerp: 0.08,
			wheelMultiplier: 0.9,
			touchMultiplier: 1.2,
		});

		window.lenis = lenis;
	}

	const initPageTransition = () => {
		const overlay = document.querySelector<HTMLElement>("[data-page-transition]");
		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

		if (!overlay || prefersReducedMotion.matches || overlay.dataset.ready) return;

		overlay.dataset.ready = "true";

		document.addEventListener("astro:before-preparation", (event) => {
			const loader = event.loader;

			document.body.dataset.transition = "active";
			overlay.dataset.state = "cover";

			event.loader = async () => {
				await new Promise((resolve) => window.setTimeout(resolve, 1300));
				await loader();
			};
		});

		document.addEventListener("astro:after-swap", () => {
			document.body.dataset.transition = "active";

			requestAnimationFrame(() => {
				overlay.dataset.state = "reveal";
			});

			window.setTimeout(() => {
				overlay.dataset.state = "idle";
				delete document.body.dataset.transition;
			}, 1500);
		});
	};

	initPageTransition();
	document.addEventListener("astro:page-load", initPageTransition);
</script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
