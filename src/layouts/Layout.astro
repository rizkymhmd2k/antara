---
import { ClientRouter } from "astro:transitions";
import ScreenWidth from "../components/ui/ScreenWidth.astro";
import Navbar from "../components/Navbar.astro";
import "lenis/dist/lenis.css";
import "../styles/global.css";
import faviconUrl from "../assets/icon/AntaraFavicon.svg?url";
import logoUrl from "../assets/icon/AntaraSVG.svg?url";
import regularFontUrl from "../assets/fonts/AlteHaasGroteskRegular.ttf?url";
import { getEntry } from "astro:content";

const defaults = await getEntry("site", "layout-defaults");
const layoutDefaults = defaults?.data as {
  defaultTitle: string;
  defaultDescription: string;
};

const {
  class: className = "",
  title = layoutDefaults.defaultTitle,
  description = layoutDefaults.defaultDescription,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://antarawealth.pages.dev");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const absoluteLogoUrl = new URL(logoUrl, siteUrl);
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Antara Private Wealth",
  url: siteUrl.href,
  logo: absoluteLogoUrl.href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#004cbb" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Antara Private Wealth" />
    <meta property="og:image" content={absoluteLogoUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteLogoUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <link
      rel="preload"
      href={regularFontUrl}
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-VVZYB5BCK4"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        window.dataLayer.push(arguments);
      }

      window.gtag = gtag;

      gtag("consent", "default", {
        analytics_storage: "granted",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
      });

      gtag("js", new Date());
      gtag("config", "G-VVZYB5BCK4", {
        send_page_view: false,
      });

      document.addEventListener("astro:page-load", () => {
        gtag("event", "page_view", {
          page_title: document.title,
          page_location: window.location.href,
          page_path: window.location.pathname,
        });
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        const link = target instanceof Element
          ? target.closest("[data-ga-event]")
          : null;
        const eventName = link?.getAttribute("data-ga-event");

        if (!eventName) return;

        gtag("event", eventName, {
          location: "contact_cta",
          link_url: link instanceof HTMLAnchorElement ? link.href : undefined,
          page_path: window.location.pathname,
        });
      });
    </script>

    <ClientRouter />
  </head>

  <body>
    <!-- <ScreenWidth /> -->

    <Navbar />

    <main class={className}>
      <slot />
    </main>

    <div
      class="page-transition"
      data-page-transition
      transition:persist
      aria-hidden="true"
    >
      <span></span>
      <span></span>
      <span></span>
    </div>
  </body>
</html>

<script>
  import Lenis from "lenis";

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const lenis = new Lenis({
      autoRaf: true,
      anchors: true,
      lerp: 0.08,
      wheelMultiplier: 0.9,
      touchMultiplier: 1.2,
    });

    window.lenis = lenis;
  }

  const initPageTransition = () => {
    const overlay = document.querySelector<HTMLElement>(
      "[data-page-transition]",
    );
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    if (!overlay || prefersReducedMotion.matches || overlay.dataset.ready)
      return;

    overlay.dataset.ready = "true";

    document.addEventListener("astro:before-preparation", (event) => {
      const loader = event.loader;

      document.body.dataset.transition = "active";
      overlay.dataset.state = "cover";

      event.loader = async () => {
        await new Promise((resolve) => window.setTimeout(resolve, 1300));
        await loader();
      };
    });

    document.addEventListener("astro:after-swap", () => {
      document.body.dataset.transition = "active";

      requestAnimationFrame(() => {
        overlay.dataset.state = "reveal";
      });

      window.setTimeout(() => {
        overlay.dataset.state = "idle";
        delete document.body.dataset.transition;
      }, 1500);
    });
  };

  initPageTransition();
  document.addEventListener("astro:page-load", initPageTransition);
</script>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow-x: clip;
  }

  @supports not (overflow: clip) {
    :global(html),
    :global(body) {
      overflow-x: hidden;
    }
  }
</style>
