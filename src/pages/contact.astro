---
import Layout from "../layouts/Layout.astro";
import Location from "../components/about/Location.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
import Footer from "../components/sections/Footer.astro";
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";

const contact = await getEntry("site", "contact");
const homeHero = await getEntry("site", "home-hero");
const data = contact?.data as {
  email: string;
  eyebrow: string;
  headline: string;
  button: string;
};
const hero = homeHero?.data as { href: string };
const inquiryHref = hero.href;
const easing = "ease-[cubic-bezier(0.16,1,0.3,1)]";
---

<Layout
  class="bg-grid-3"
  title="Contact | Antara Private Wealth"
  description="Start a conversation with Antara Private Wealth."
>
  <div class="relative isolate">
    <div class="relative z-10">
      <section
        class="hero-padding relative flex min-h-[72dvh] flex-col justify-end pb-16 sm:min-h-[76dvh] sm:pb-24 lg:pb-28"
        aria-labelledby="contact-title"
      >
        <div class="grid w-full min-w-0 gap-10 lg:grid-cols-12 lg:gap-8">
          <div class="min-w-0 lg:col-span-8">
            <Eyebrow text={data.eyebrow} />
            <h1
              id="contact-title"
              class="display-text mt-4 max-w-[12ch] leading-[0.95] [overflow-wrap:break-word]"
            >
              Contact Antara Private Wealth.
            </h1>
          </div>

          <div class="flex min-w-0 items-end lg:col-span-4">
            <p class="body-text max-w-[20rem] min-w-0 text-white/85 sm:max-w-[30rem]">
              Start with the decision in front of you. We will help frame the
              right conversation from there.
            </p>
          </div>
        </div>
      </section>

      <section
        class="container-padding border-t border-white/35"
        aria-labelledby="details-title"
      >
        <div class="grid min-w-0 gap-12 lg:grid-cols-12 lg:gap-0">
          <div class="min-w-0 lg:col-span-4">
            <Eyebrow text="Contact details" />
            <h2
              id="details-title"
              class="mt-4 max-w-[13ch] text-[clamp(2.75rem,4vw,6rem)] leading-[0.92]"
            >
              A considered first step toward clearer decisions.
            </h2>
          </div>

          <div class="min-w-0 lg:col-span-8">
            <div class="min-w-0 border-y border-white/35">
              <a
                href={inquiryHref}
                aria-label={`Send an email to ${data.email}`}
                class="group grid min-w-0 gap-6 px-4 py-7 transition-colors duration-300 hover:bg-white hover:text-background focus-visible:bg-white focus-visible:text-background focus-visible:outline-none sm:grid-cols-[8rem_1fr_4rem] sm:items-end sm:gap-8 sm:px-6 sm:py-8"
                data-ga-event="contact_email_click"
              >
                <span class="flex items-center gap-3 text-base normal-case text-white/80 transition-colors duration-300 group-hover:text-background sm:pt-3 md:text-lg">
                  <span>Send an email</span>
                  <Icon
                    name="arrow-up-right"
                    aria-hidden="true"
                    class="size-5 sm:hidden"
                  />
                </span>
                <span class="relative block min-w-0 overflow-hidden">
                  <span
                    class={`block text-[clamp(1.75rem,8vw,6.5rem)] leading-[0.9] transition-transform duration-500 [overflow-wrap:anywhere] ${easing} group-hover:-translate-y-full sm:text-[clamp(2.4rem,7vw,6.5rem)] sm:leading-[0.86]`}
                  >
                    {data.email}
                  </span>
                  <span
                    aria-hidden="true"
                    class={`absolute left-0 top-full block text-[clamp(1.75rem,8vw,6.5rem)] leading-[0.9] transition-transform duration-500 [overflow-wrap:anywhere] ${easing} group-hover:-translate-y-full sm:text-[clamp(2.4rem,7vw,6.5rem)] sm:leading-[0.86]`}
                  >
                    {data.email}
                  </span>
                  <span class="mt-3 block text-sm normal-case tracking-normal text-white/60 transition-colors duration-300 group-hover:text-background sm:hidden">
                    Tap to open your mail app
                  </span>
                </span>
                <span class="relative hidden size-10 items-center justify-center justify-self-end overflow-hidden sm:flex">
                  <Icon
                    name="arrow-up-right"
                    aria-hidden="true"
                    class={`absolute size-10 text-white transition-all duration-500 ${easing} group-hover:translate-x-8 group-hover:-translate-y-8 group-hover:text-background group-hover:opacity-0 group-focus-visible:translate-x-8 group-focus-visible:-translate-y-8 group-focus-visible:text-background group-focus-visible:opacity-0`}
                  />
                  <Icon
                    name="arrow-up-right"
                    aria-hidden="true"
                    class={`absolute size-10 -translate-x-8 translate-y-8 text-background opacity-0 transition-all delay-[60ms] duration-500 ${easing} group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:translate-y-0 group-focus-visible:opacity-100`}
                  />
                </span>
                <span class="sr-only">Opens email client</span>
              </a>
            </div>

            <div class="mt-8 grid min-w-0 gap-8 px-4 sm:grid-cols-[6rem_1fr] sm:px-6">
              <span class="text-base normal-case text-white/80 md:text-lg">For</span>
              <div class="min-w-0">
                <p class="title-text max-w-[34rem] text-white/95">
                  Families, founders, and stewards making decisions around
                  meaningful capital.
                </p>
                <p class="body-text mt-5 max-w-[32rem]">
                  {data.headline}
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <Location class="border-t border-white/35" />

      <section
        class="container-padding border-t border-white/35"
        aria-labelledby="conversation-title"
      >
        <div class="grid min-w-0 gap-12 lg:grid-cols-12 lg:gap-8">
          <div class="min-w-0 lg:col-span-7">
            <Eyebrow text="Begin here" />
            <h2
              id="conversation-title"
              class="mt-4 max-w-[13ch] text-[clamp(2.75rem,7vw,6.5rem)] leading-[0.95]"
            >
              Bring us the question you are carrying.
            </h2>
          </div>

          <div class="flex min-w-0 flex-col justify-end gap-6 lg:col-span-4 lg:col-start-9">
            <p class="body-text max-w-[28rem] min-w-0">
              No form. No forced path. Send a note and we will continue the
              conversation privately.
            </p>
            <Button
              text={data.button}
              href={inquiryHref}
              trackingEvent="contact_email_click"
            />
          </div>
        </div>
      </section>

      <Footer />
    </div>
  </div>
</Layout>
