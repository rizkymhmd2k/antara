---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Who from "../components/sections/Who.astro";
import Numbers from "../components/sections/Numbers.astro";
import Diffrence from "../components/sections/Diffrence.astro";
import Serve from "../components/sections/Serve.astro";
import Service from "../components/sections/Service.astro";
import Step from "../components/sections/Step.astro";
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/sections/Footer.astro";
---

<Layout
	class="bg-grid-3"
	title="Antara Private Wealth | Precisely Held"
	description="Antara Private Wealth brings order, intention, and confidence to decisions surrounding significant capital."
>
  <div class="relative isolate">
    <div class="relative z-10">
      <Hero />
      <Who />
      <Numbers />
      <Diffrence />
      <Serve />
      <Service />
      <Step />
      <Contact />
      <Footer />
    </div>
  </div>
</Layout>
