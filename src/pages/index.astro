---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Who from "../components/sections/Who.astro";
import Numbers from "../components/sections/Numbers.astro";
import Diffrence from "../components/sections/Diffrence.astro";
import Serve from "../components/sections/Serve.astro";
import Service from "../components/sections/Service.astro";
import Step from "../components/sections/Step.astro";
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/sections/Footer.astro";
import StairTransition from "../components/ui/StairTransition.astro";
import { getEntry } from "astro:content";

const page = await getEntry("site", "home-page");
const data = page?.data as { title: string; description: string };
---

<Layout class="bg-grid-3" title={data.title} description={data.description}>
  <div class="relative isolate">
    <div class="relative z-10">
      <div class="relative isolate overflow-hidden">
        <Hero />
        <Who />
      </div>
      <Diffrence />
      <StairTransition to="white" />
      <Numbers />
      <Serve />
      <StairTransition to="blue" />
      <Service />
      <Step />
      <Contact />
      <Footer />
    </div>
  </div>
</Layout>
