---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/about/Hero.astro";
import Team from "../components/about/Team.astro";
import Values from "../components/about/Values.astro";
import Location from "../components/about/Location.astro"
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/sections/Footer.astro";
import { getEntry } from "astro:content";

const page = await getEntry("site", "about-page");
const data = page?.data as { title: string; description: string };
---

<Layout
	class="bg-grid-3"
	title={data.title}
	description={data.description}
>
  <div class="relative">
    <Hero />
    <Values />
    <Team />
    <Location />
    <Contact />
    <Footer />
  </div>
</Layout>
