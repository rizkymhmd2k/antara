---
const VIEW_W = 1440;
const VIEW_H = 900;

const center = { x: VIEW_W / 2, y: VIEW_H / 2 };

const RX_MAX = 900;
const RX_MIN = 18;

const N_RINGS = 38;

const rings = Array.from({ length: N_RINGS }, (_, index) => {
  const t = index / (N_RINGS - 1);
  const eased = Math.pow(t, 1.35);

  const rx = RX_MAX - eased * (RX_MAX - RX_MIN);
  const ry = rx * (0.32 - t * 0.16);
  const cy = center.y + 78 + Math.pow(t, 1.85) * 148;

  return {
    rx,
    ry,
    cy,
    opacity: 0.035 + t * 0.12,
    delay: `${-index * 0.18}s`,
    duration: `${(18 - t * 8).toFixed(2)}s`,
  };
});
---

<div class="gravity-rings" aria-hidden="true">
  <svg
    class="gravity-rings__svg"
    viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
    preserveAspectRatio="xMidYMid slice"
  >
    <g class="gravity-rings__field">
      {
        rings.map((ring) => (
          <>
            <ellipse
              class="gravity-rings__ring"
              cx={center.x}
              cy={ring.cy}
              rx={ring.rx}
              ry={ring.ry}
              pathLength="100"
              style={`--ring-opacity:${ring.opacity};`}
            />
            <ellipse
              class="gravity-rings__ring gravity-rings__ring--flow"
              cx={center.x}
              cy={ring.cy}
              rx={ring.rx}
              ry={ring.ry}
              pathLength="100"
              style={`--ring-delay:${ring.delay};--ring-duration:${ring.duration};`}
            />
          </>
        ))
      }
    </g>
  </svg>
</div>

<style>
  .gravity-rings {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 900px;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .gravity-rings__svg {
    width: 100%;
    height: 100%;
    display: block;
    transform: translateY(10px);
  }

  .gravity-rings__field {
    shape-rendering: geometricPrecision;
  }

  .gravity-rings__ring {
    fill: none;
    stroke: rgb(255 255 255);
    stroke-width: 1.35;
    stroke-opacity: var(--ring-opacity);
    vector-effect: non-scaling-stroke;
  }

  .gravity-rings__ring--flow {
    stroke-opacity: 0.08;
    stroke-dasharray: 8 92;
    stroke-dashoffset: 0;
    animation: gravity-ring-loop var(--ring-duration) linear infinite;
    animation-delay: var(--ring-delay);
  }

  @keyframes gravity-ring-loop {
    to {
      stroke-dashoffset: -100;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gravity-rings__ring--flow {
      animation: none;
    }
  }
</style>
