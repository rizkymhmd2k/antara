---
interface Props {
  to: "white" | "blue";
}

const { to } = Astro.props;
---

<div
  class:list={["stair-transition bg-grid-3", { "to-blue": to === "blue" }]}
  data-stair-transition
  aria-hidden="true"
>
  {Array.from({ length: 3 }, () => (
    <div class="stair-row"><span></span><span></span></div>
  ))}
</div>

<script>
  let cleanup: (() => void) | undefined;

  function initStairTransitions() {
    cleanup?.();
    const transitions = Array.from(document.querySelectorAll<HTMLElement>("[data-stair-transition]"));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;

    const update = () => {
      frame = 0;
      transitions.forEach((transition) => {
        const bottom = transition.getBoundingClientRect().bottom;
        const progress = Math.min(1, Math.max(0,
          (window.innerHeight - bottom) / (window.innerHeight * 0.7),
        ));
        Array.from(transition.children).forEach((row, index) => {
          const amount = reducedMotion.matches ? 1 : Math.min(1, Math.max(0,
            progress * 1.4 - (2 - index) * 0.2,
          ));
          row.querySelectorAll<HTMLElement>("span").forEach((bar) => {
            bar.style.transform = `scaleX(${amount})`;
          });
        });
      });

    };
    const requestUpdate = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    update();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    reducedMotion.addEventListener("change", requestUpdate);
    cleanup = () => {
      if (frame) cancelAnimationFrame(frame);
      window.removeEventListener("scroll", requestUpdate);
      window.removeEventListener("resize", requestUpdate);
      reducedMotion.removeEventListener("change", requestUpdate);
    };
  }

  initStairTransitions();
  document.addEventListener("astro:page-load", initStairTransitions);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>

<style>
  .stair-transition {
    --grid-line-color: rgb(128 128 128 / 20%);
    position: relative;
    height: 270px;
    background: var(--color-background);
    overflow: hidden;
    pointer-events: none;
  }

  .stair-transition::before {
    z-index: 1;
  }

  .stair-row {
    display: flex;
    justify-content: space-between;
    height: 90px;
  }

  .stair-row span {
    display: block;
    background: var(--color-surface);
    transform: scaleX(0);
  }

  .stair-row span:first-child { transform-origin: left center; }
  .stair-row span:last-child { transform-origin: right center; }
  .stair-row span { width: 50%; }

  .stair-transition.to-blue {
    background: var(--color-surface);
  }

  .stair-transition.to-blue .stair-row span {
    background: var(--color-background);
  }

  @media (max-width: 47.999rem) {
    .stair-transition { height: 210px; }
    .stair-row { height: 70px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stair-transition { height: 3rem; }
    .stair-row { display: none; }
  }
</style>
