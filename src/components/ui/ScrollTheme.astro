<div class="scroll-theme" data-scroll-theme>
  <div class="scroll-theme__surface" aria-hidden="true"></div>
  <div class="scroll-theme__content"><slot /></div>
</div>

<style>
  .scroll-theme { position: relative; isolation: isolate; }
  .scroll-theme__surface {
    position: fixed;
    inset: 0;
    background: var(--color-surface);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
    will-change: opacity;
  }
  .scroll-theme__content { position: relative; z-index: 1; }

  .scroll-theme.is-enabled { color: var(--theme-ink, white); }
  .scroll-theme.is-enabled :global(.snapshot),
  .scroll-theme.is-enabled :global(.serve) {
    background: transparent;
    color: inherit;
    --grid-line-color: var(--theme-rule);
    --serve-rule: var(--theme-rule);
    --serve-plus-border: var(--theme-rule);
    --serve-plus-background: transparent;
  }
  .scroll-theme.is-enabled :global(.snapshot-stats),
  .scroll-theme.is-enabled :global(.snapshot-stat) {
    border-color: var(--theme-rule);
  }
</style>

<script>
  let cleanupTheme: (() => void) | undefined;

  function initScrollTheme() {
    cleanupTheme?.();
    const root = document.querySelector<HTMLElement>("[data-scroll-theme]");
    const surface = root?.querySelector<HTMLElement>(".scroll-theme__surface");
    const numbers = root?.querySelector<HTMLElement>(".snapshot");
    const services = root?.querySelector<HTMLElement>("[data-services-section]");
    if (!root || !surface || !numbers || !services) return;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;
    let enter = 0;
    let leave = 0;
    let span = 1;
    let last = -1;
    const clamp = (n: number) => Math.max(0, Math.min(1, n));
    const update = () => {
      frame = 0;
      if (reduced.matches) return;
      const incoming = clamp((scrollY - enter) / span);
      const outgoing = clamp((scrollY - leave) / span);
      const progress = Math.round(Math.min(incoming, 1 - outgoing) * 1000) / 1000;
      if (progress === last) return;
      last = progress;
      surface.style.opacity = String(progress);
      // White → neutral gray → brand blue, continuously in both directions.
      const toGray = progress <= 0.5;
      const amount = toGray ? progress * 2 : (progress - 0.5) * 2;
      const from = toGray ? [255, 255, 255] : [160, 160, 160];
      const to = toGray ? [160, 160, 160] : [0, 76, 187];
      const ink = from.map((channel, index) =>
        (channel + (to[index] - channel) * amount).toFixed(2),
      ).join(" ");
      root.style.setProperty("--theme-ink", `rgb(${ink})`);
      root.style.setProperty("--theme-rule", `rgb(${ink} / 16%)`);
    };
    const schedule = () => {
      if (!frame && !reduced.matches && !document.hidden) frame = requestAnimationFrame(update);
    };
    const measure = () => {
      enter = numbers.getBoundingClientRect().top + scrollY - innerHeight * 0.9;
      leave = services.getBoundingClientRect().top + scrollY - innerHeight * 0.9;
      span = Math.max(1, innerHeight * 0.75);
      schedule();
    };
    const sync = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      last = -1;
      root.classList.toggle("is-enabled", !reduced.matches);
      surface.style.opacity = "0";
      measure();
    };
    const observer = new ResizeObserver(measure);
    observer.observe(root);
    sync();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", measure);
    document.addEventListener("visibilitychange", schedule);
    reduced.addEventListener("change", sync);
    cleanupTheme = () => {
      cancelAnimationFrame(frame);
      observer.disconnect();
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", measure);
      document.removeEventListener("visibilitychange", schedule);
      reduced.removeEventListener("change", sync);
      root.classList.remove("is-enabled");
      surface.style.opacity = "0";
    };
  }
  initScrollTheme();
  document.addEventListener("astro:page-load", initScrollTheme);
  document.addEventListener("astro:before-swap", () => cleanupTheme?.());
</script>
