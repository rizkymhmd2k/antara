---
interface Props {
  src: string;
  class?: string;
  imgClass?: string;
  mobileEndOffset?: number;
}

const {
  src,
  class: className = "",
  imgClass = "h-full w-full max-w-none",
  mobileEndOffset = 1,
} = Astro.props as Props;

const instanceId = `scroll-line-${Math.random().toString(36).slice(2, 10)}`;
---

<div
  id={instanceId}
  class:list={["scroll-line", className]}
  style="--scroll-line-progress: 0;"
  aria-hidden="true"
>
  <div class="scroll-line__canvas h-full w-full"></div>
</div>

<script define:vars={{ instanceId, src, imgClass, mobileEndOffset }}>
  const line = document.getElementById(instanceId);
  const mediaQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  const mobileQuery = window.matchMedia("(max-width: 767px)");
  const START_OFFSET = 0.35;
  const END_OFFSET = 1;

  if (line instanceof HTMLElement) {
    let ticking = false;
    let revealRect = null;
    let revealWidth = 0;
    const canvas = line.querySelector(".scroll-line__canvas");

    const clamp = (value) => Math.min(1, Math.max(0, value));

    const applyProgress = (value) => {
      line.style.setProperty("--scroll-line-progress", value.toString());

      if (revealRect instanceof SVGRectElement) {
        revealRect.setAttribute("width", `${revealWidth * value}`);
      }
    };

    const getProgress = () => {
      const rect = line.getBoundingClientRect();
      const startPx = window.innerHeight * (1 - START_OFFSET);
      const endOffset = mobileQuery.matches ? mobileEndOffset : END_OFFSET;
      const endPx = window.innerHeight * (1 - endOffset);
      const distance = startPx - endPx;

      if (distance === 0) {
        return rect.top <= startPx ? 1 : 0;
      }

      return clamp((startPx - rect.top) / distance);
    };

    const render = () => {
      ticking = false;

      if (mediaQuery.matches) {
        applyProgress(1);
        return;
      }

      const progress = getProgress() ** 1.6;
      applyProgress(progress);
    };

    const scheduleRender = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(render);
    };

    const updateSvgSizeMode = () => {
      const svg = canvas?.querySelector("svg");
      if (!(svg instanceof SVGElement)) return;

      svg.setAttribute(
        "preserveAspectRatio",
        mobileQuery.matches ? "xMidYMid slice" : "none",
      );
    };

    const createSvgWideReveal = (svg) => {
      const namespace = "http://www.w3.org/2000/svg";
      const clipId = `${instanceId}-clip`;
      const viewBox = svg.viewBox.baseVal;
      const hasViewBox = viewBox && viewBox.width > 0 && viewBox.height > 0;
      const bounds = hasViewBox
        ? {
            x: viewBox.x,
            y: viewBox.y,
            width: viewBox.width,
            height: viewBox.height,
          }
        : {
            x: 0,
            y: 0,
            width: svg.getBoundingClientRect().width || 1,
            height: svg.getBoundingClientRect().height || 1,
          };

      let defs = svg.querySelector(":scope > defs");
      if (!(defs instanceof SVGDefsElement)) {
        defs = document.createElementNS(namespace, "defs");
        svg.prepend(defs);
      }

      const clipPath = document.createElementNS(namespace, "clipPath");
      clipPath.setAttribute("id", clipId);
      clipPath.setAttribute("clipPathUnits", "userSpaceOnUse");

      const rect = document.createElementNS(namespace, "rect");
      rect.setAttribute("x", `${bounds.x}`);
      rect.setAttribute("y", `${bounds.y}`);
      rect.setAttribute("width", "0");
      rect.setAttribute("height", `${bounds.height}`);
      clipPath.append(rect);
      defs.append(clipPath);

      const group = document.createElementNS(namespace, "g");
      group.setAttribute("clip-path", `url(#${clipId})`);

      for (const child of Array.from(svg.children)) {
        if (child === defs || child === group) continue;
        group.append(child);
      }

      svg.append(group);
      revealRect = rect;
      revealWidth = bounds.width;
    };

    const init = async () => {
      if (!(canvas instanceof HTMLElement)) return;

      try {
        const response = await fetch(src);
        const markup = await response.text();
        canvas.innerHTML = markup;

        const svg = canvas.querySelector("svg");
        if (!(svg instanceof SVGElement)) return;

        svg.setAttribute("aria-hidden", "true");
        svg.setAttribute("focusable", "false");
        svg.setAttribute("class", `block ${imgClass}`.trim());
        // Runtime-injected SVG does not reliably receive generated utility CSS.
        // Set width inline so every ScrollLine fills its canvas.
        svg.style.display = "block";
        svg.style.width = "100%";
        svg.style.maxWidth = "none";
        updateSvgSizeMode();
        createSvgWideReveal(svg);

        line.dataset.ready = "true";
        render();
        window.addEventListener("scroll", scheduleRender, { passive: true });
        window.addEventListener("resize", scheduleRender);
        mediaQuery.addEventListener("change", render);
        mobileQuery.addEventListener("change", updateSvgSizeMode);
      } catch (error) {
        console.error(`Failed to load scroll line: ${src}`, error);
      }
    };

    init();
  }
</script>

<style>
  .scroll-line {
    opacity: 0;
  }

  .scroll-line[data-ready="true"] {
    opacity: 1;
  }

  .scroll-line :global(svg) {
    overflow: visible;
    display: block;
    width: 100%;
    max-width: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line {
      --scroll-line-progress: 1;
    }
  }
</style>
