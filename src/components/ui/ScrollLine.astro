---
interface Props {
  src: string;
  class?: string;
  imgClass?: string;
  mobileEndOffset?: number;
}

const {
  src,
  class: className = "",
  imgClass = "h-full w-full max-w-none",
  mobileEndOffset = 1,
} = Astro.props as Props;

const instanceId = `scroll-line-${Math.random().toString(36).slice(2, 10)}`;
---

<div
  id={instanceId}
  class:list={["scroll-line", className]}
  style="--scroll-line-progress: 0;"
  aria-hidden="true"
>
  <div class="scroll-line__canvas h-full w-full"></div>
</div>

<script define:vars={{ instanceId, src, imgClass, mobileEndOffset }}>
  const line = document.getElementById(instanceId);
  const mediaQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  const mobileQuery = window.matchMedia("(max-width: 767px)");
  const START_OFFSET = 0.35;
  const END_OFFSET = 1;

  if (line instanceof HTMLElement) {
    let ticking = false;
    let segments = [];
    const canvas = line.querySelector(".scroll-line__canvas");

    const clamp = (value) => Math.min(1, Math.max(0, value));

    const applyProgress = (value) => {
      line.style.setProperty("--scroll-line-progress", value.toString());

      for (const segment of segments) {
        segment.style.strokeDashoffset = `calc(${segment.dataset.length} * ${1 - value})`;
      }
    };

    const getProgress = () => {
      const rect = line.getBoundingClientRect();
      const startPx = window.innerHeight * (1 - START_OFFSET);
      const endOffset = mobileQuery.matches ? mobileEndOffset : END_OFFSET;
      const endPx = window.innerHeight * (1 - endOffset);
      const distance = startPx - endPx;

      if (distance === 0) {
        return rect.top <= startPx ? 1 : 0;
      }

      return clamp((startPx - rect.top) / distance);
    };

    const render = () => {
      ticking = false;

      if (mediaQuery.matches) {
        applyProgress(1);
        return;
      }

      const progress = getProgress() ** 1.6;
      applyProgress(progress);
    };

    const scheduleRender = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(render);
    };

    const updateSvgSizeMode = () => {
      const svg = canvas?.querySelector("svg");
      if (!(svg instanceof SVGElement)) return;

      svg.setAttribute(
        "preserveAspectRatio",
        mobileQuery.matches ? "xMidYMid slice" : "none",
      );
    };

    const init = async () => {
      if (!(canvas instanceof HTMLElement)) return;

      try {
        const response = await fetch(src);
        const markup = await response.text();
        canvas.innerHTML = markup;

        const svg = canvas.querySelector("svg");
        if (!(svg instanceof SVGElement)) return;

        svg.setAttribute("aria-hidden", "true");
        svg.setAttribute("focusable", "false");
        svg.setAttribute("class", `block ${imgClass}`.trim());
        updateSvgSizeMode();

        segments = Array.from(
          svg.querySelectorAll("path, line, polyline, polygon, circle, ellipse"),
        ).filter((element) => typeof element.getTotalLength === "function");

        for (const segment of segments) {
          const length = segment.getTotalLength();
          segment.dataset.length = `${length}`;
          segment.style.strokeDasharray = `${length}`;
          segment.style.strokeDashoffset = `${length}`;
        }

        line.dataset.ready = "true";
        render();
        window.addEventListener("scroll", scheduleRender, { passive: true });
        window.addEventListener("resize", scheduleRender);
        mediaQuery.addEventListener("change", render);
        mobileQuery.addEventListener("change", updateSvgSizeMode);
      } catch (error) {
        console.error(`Failed to load scroll line: ${src}`, error);
      }
    };

    init();
  }
</script>

<style>
  .scroll-line {
    opacity: 0;
  }

  .scroll-line[data-ready="true"] {
    opacity: 1;
  }

  .scroll-line :global(svg) {
    overflow: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line {
      --scroll-line-progress: 1;
    }
  }
</style>
