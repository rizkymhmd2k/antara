---
import { getEntry } from "astro:content";

export interface Props {
  class?: string;
  strokeWidth?: number;
  animated?: boolean;
}

const {
  class: className = "",
  strokeWidth = 1,
  animated = true,
} = Astro.props;

const content = await getEntry("site", "home-lines");
const data = content?.data as { anchorText: string };

const LINE_COUNT = 18;

const makePath = (index: number) => {
  const t = index / (LINE_COUNT - 1);
  const back = 1 - t;
  const drift = 0;

  // Coordinates follow the reference's 700 × 312 composition. The right
  // crest folds back toward the bottom edge instead of exiting sideways.
  return [
    // Reverse strand order across the neck to turn the ribbon edge-on.
    `M -20 ${40 + back * 62}`,
    `C 55 ${133 - back * 14}, 125 ${77 + back * 37}, 205 ${95 + back * 35}`,
    `C ${300 + drift} ${113 + back * 32}, ${293 + drift} ${207 + t * 53}, ${350 + drift} ${217 + t * 50}`,
    `C ${408 + drift} ${229 + t * 55}, ${463 - drift} ${119 + t * 83}, ${552 - drift} ${122 + t * 78}`,
    `C ${655 - drift} ${122 + t * 78}, ${650 + t * 84} ${242 + t * 10}, ${532 + t * 116} 330`,
    `C ${414 + t * 148} ${418 - t * 10}, ${185 + drift + t * 75} ${399 + t * 22}, ${133 + drift + t * 60} ${465 + t * 17}`,
    `C ${81 + drift + t * 45} ${531 + t * 12}, ${225 + t * 65} 598, ${430 + t * 80} 660`,
  ].join(" ");
};

const lines = Array.from({ length: LINE_COUNT }, (_, index) => ({
  d: makePath(index),
}));
---

<div
  class:list={["white-lines", className, { "is-static": !animated }]}
  style={`--white-lines-stroke:${strokeWidth};`}
  aria-hidden="true"
>
  <svg
    class="white-lines__svg"
    viewBox="0 0 700 312"
    preserveAspectRatio="xMidYMin slice"
  >
    <defs>
      <linearGradient id="home-ribbon-fade" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="660">
        <stop offset="0" stop-color="white" />
        <stop offset="0.48" stop-color="white" />
        <stop offset="0.72" stop-color="white" stop-opacity="0.5" />
        <stop offset="1" stop-color="white" stop-opacity="0" />
      </linearGradient>
      <mask id="home-ribbon-mask" maskUnits="userSpaceOnUse" x="-100" y="0" width="900" height="700">
        <rect x="-100" width="900" height="700" fill="url(#home-ribbon-fade)" />
      </mask>
      <linearGradient id="home-ribbon-depth" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="700" y2="0">
        <stop offset="0" stop-color="white" stop-opacity="0.36" />
        <stop offset="0.34" stop-color="white" stop-opacity="0.42" />
        <stop offset="0.43" stop-color="white" stop-opacity="0.2" />
        <stop offset="0.48" stop-color="white" stop-opacity="0.46" />
        <stop offset="0.68" stop-color="white" stop-opacity="0.36" />
        <stop offset="0.86" stop-color="white" stop-opacity="0.45" />
        <stop offset="0.92" stop-color="white" stop-opacity="0.18" />
        <stop offset="1" stop-color="white" stop-opacity="0.34" />
      </linearGradient>
    </defs>
    <g class="white-lines__ribbon" mask="url(#home-ribbon-mask)">
      {lines.map((line) => (
        <path d={line.d} class="white-lines__path" />
      ))}
    </g>
  </svg>
  <p class="white-lines__anchor-text text-xs sm:text-sm">
    {data.anchorText.split("\n").map((line, index) => (
      <>
        {line}
        {index < data.anchorText.split("\n").length - 1 && <br />}
      </>
    ))}
  </p>
</div>

<style>
  .white-lines {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }

  .white-lines__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .white-lines:not(.is-static) .white-lines__svg {
      animation: ribbon-drift 14s ease-in-out infinite alternate;
      animation-play-state: paused;
      transform-origin: center;
    }

    .white-lines.is-visible .white-lines__svg {
      animation-play-state: running;
    }
  }

  @keyframes ribbon-drift {
    from { transform: translate3d(-6px, -4px, 0) rotate(-0.25deg); }
    to { transform: translate3d(6px, 4px, 0) rotate(0.25deg); }
  }

  .white-lines__path {
    fill: none;
    stroke: url(#home-ribbon-depth);
    stroke-width: var(--white-lines-stroke);
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .white-lines__anchor-text {
    position: absolute;
    left: 56.5%;
    top: 23%;
    color: rgb(255 255 255 / 0.82);
    margin: 0;
    text-align: left;
  }

  @media (max-width: 47.99rem) {
    .white-lines__anchor-text {
      top: 14%;
      right: 1rem;
      left: auto;
      width: 9rem;
    }
  }

</style>

<script>
  let cleanupRibbon: (() => void) | undefined;

  function initRibbon() {
    cleanupRibbon?.();
    const ribbon = document.querySelector<HTMLElement>(".white-lines:not(.is-static)");
    // The ribbon extends through both Hero and Who, beyond its SVG viewport.
    const region = ribbon?.parentElement?.parentElement;
    if (!ribbon || !region) return;
    let visible = false;
    const update = () => ribbon.classList.toggle("is-visible", visible && !document.hidden);
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      update();
    });
    observer.observe(region);
    document.addEventListener("visibilitychange", update);
    cleanupRibbon = () => {
      observer.disconnect();
      document.removeEventListener("visibilitychange", update);
      ribbon.classList.remove("is-visible");
    };
  }

  initRibbon();
  document.addEventListener("astro:page-load", initRibbon);
  document.addEventListener("astro:before-swap", () => cleanupRibbon?.());
</script>
