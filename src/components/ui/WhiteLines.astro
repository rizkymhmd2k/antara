---
export interface Props {
  class?: string;
  strokeWidth?: number;
  animated?: boolean;
}

const {
  class: className = "",
  strokeWidth = 1,
  animated = true,
} = Astro.props;

const lines = [
  "M -100 240 Q 500 240, 900 180 T 1600 60",
  "M -100 320 Q 520 300, 900 180 T 1600 0",
  "M -100 400 Q 540 360, 900 180 T 1600 -60",
  "M -100 480 Q 560 420, 900 180 T 1600 -120",
  "M -100 560 Q 580 480, 900 180 T 1600 -180",
];
---

<div
  class:list={["white-lines", className, { "is-static": !animated }]}
  style={`--white-lines-stroke:${strokeWidth};`}
  aria-hidden="true"
>
  <svg
    class="white-lines__svg"
    viewBox="0 0 1440 600"
    preserveAspectRatio="none"
  >
    <g class="white-lines__drift-group">
      {lines.map((path) => (
        <path d={path} class="white-lines__path" />
      ))}
    </g>
  </svg>
</div>

<style>
  .white-lines {
    position: absolute;
    inset: 0 0 auto 0;
    height: 30%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .white-lines__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .white-lines__path {
    fill: none;
    stroke: rgb(255 255 255 / 0.15);
    stroke-width: var(--white-lines-stroke);
    vector-effect: non-scaling-stroke;
  }

  .white-lines__drift-group {
    animation: drift 20s ease-in-out infinite alternate;
  }

  .is-static .white-lines__drift-group {
    animation: none;
  }

  @keyframes drift {
    from {
      transform: translateY(-4px);
    }
    to {
      transform: translateY(4px);
    }
  }
</style>