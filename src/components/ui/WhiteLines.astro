---
export interface Props {
  class?: string;
  strokeWidth?: number;
  animated?: boolean;
}

const {
  class: className = "",
  strokeWidth = 1,
  animated = true,
} = Astro.props;

// FIX: The third path in each `wave` string now matches the first path.
// This allows the keyTimes loop to seamlessly transition back to the start.
const lines = [
  {
    d: "M -100 240 Q 500 240, 900 180 T 1600 80",
    wave:
      "M -100 232 Q 560 260, 900 180 T 1600 60;M -100 248 Q 440 220, 900 180 T 1600 100;M -100 232 Q 560 260, 900 180 T 1600 60",
    dur: "10s",
    begin: "-2s",
  },
  {
    d: "M -100 320 Q 520 320, 900 180 T 1600 0",
    wave:
      "M -100 312 Q 570 340, 900 180 T 1600 -20;M -100 328 Q 470 300, 900 180 T 1600 20;M -100 312 Q 570 340, 900 180 T 1600 -20",
    dur: "12s",
    begin: "-8s",
  },
  {
    d: "M -100 400 Q 540 400, 900 180 T 1600 -80",
    wave:
      "M -100 392 Q 600 420, 900 180 T 1600 -100;M -100 408 Q 480 380, 900 180 T 1600 -60;M -100 392 Q 600 420, 900 180 T 1600 -100",
    dur: "11s",
    begin: "-5s",
  },
  {
    d: "M -100 480 Q 560 480, 900 180 T 1600 -160",
    wave:
      "M -100 472 Q 620 500, 900 180 T 1600 -180;M -100 488 Q 500 460, 900 180 T 1600 -140;M -100 472 Q 620 500, 900 180 T 1600 -180",
    dur: "13s",
    begin: "-11s",
  },
  {
    d: "M -100 560 Q 580 560, 900 180 T 1600 -240",
    wave:
      "M -100 552 Q 640 580, 900 180 T 1600 -260;M -100 568 Q 520 540, 900 180 T 1600 -220;M -100 552 Q 640 580, 900 180 T 1600 -260",
    dur: "14s",
    begin: "-15s",
  },
];
---

<div
  class:list={["white-lines", className, { "is-static": !animated }]}
  style={`--white-lines-stroke:${strokeWidth};`}
  aria-hidden="true"
>
  <svg
    class="white-lines__svg"
    viewBox="0 0 1440 600"
    preserveAspectRatio="none"
  >
      {lines.map((line) => (
        <path d={line.d} class="white-lines__path">
          {animated && (
            <animate
              attributeName="d"
              dur={line.dur}
              begin={line.begin}
              repeatCount="indefinite"
              calcMode="spline"
              keyTimes="0;0.5;1"
              keySplines="0.42 0 0.58 1;0.42 0 0.58 1"
              values={line.wave}
            />
          )}
        </path>
      ))}
  </svg>
</div>

<style>
  .white-lines {
    position: absolute;
    inset: 0 0 auto 0;
    height: 30%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .white-lines__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .white-lines__path {
    fill: none;
    stroke: rgb(255 255 255 / 0.82);
    stroke-width: var(--white-lines-stroke);
    vector-effect: non-scaling-stroke;
  }

  .is-static animate {
    display: none;
  }
</style>