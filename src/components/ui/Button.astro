---
import { Icon } from "astro-icon/components";
const { text, href } = Astro.props;

const className =
  "group inline-flex w-fit items-center justify-between gap-4 rounded-sm bg-white px-4 py-2 sm:gap-12 transition-transform duration-200 ease-out active:scale-[0.97]";

const easing = "ease-[cubic-bezier(0.16,1,0.3,1)]";
---

{
  href ? (
    <a href={href} class={className}>
      <span class="relative inline-block overflow-hidden">
        <span
          class={`block text-xl text-black transition-transform duration-500 sm:text-md ${easing} group-hover:-translate-y-full`}
        >
          {text}
        </span>
        <span
          aria-hidden="true"
          class={`absolute left-0 top-full block text-xl text-black transition-transform duration-500 sm:text-md ${easing} group-hover:-translate-y-full`}
        >
          {text}
        </span>
      </span>

      <span class="relative flex size-9 items-center justify-center overflow-hidden rounded-sm border bg-background">
        <Icon
          name="arrow-up-right"
          aria-hidden="true"
          class={`absolute size-6 text-white transition-all duration-500 ${easing} group-hover:translate-x-4 group-hover:-translate-y-4 group-hover:opacity-0`}
        />
        <Icon
          name="arrow-up-right"
          aria-hidden="true"
          class={`absolute size-6 -translate-x-4 translate-y-4 text-white opacity-0 transition-all delay-[60ms] duration-500 ${easing} group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100`}
        />
      </span>
    </a>
  ) : (
    <button type="button" class={className}>
      <span class="relative inline-block overflow-hidden">
        <span
          class={`block text-xl text-black transition-transform duration-500 sm:text-md ${easing} group-hover:-translate-y-full`}
        >
          {text}
        </span>
        <span
          aria-hidden="true"
          class={`absolute left-0 top-full block text-xl text-black transition-transform duration-500 sm:text-md ${easing} group-hover:-translate-y-full`}
        >
          {text}
        </span>
      </span>

      <span class="relative flex size-9 items-center justify-center overflow-hidden rounded-sm border bg-background">
        <Icon
          name="arrow-up-right"
          aria-hidden="true"
          class={`absolute size-6 text-white transition-all duration-500 ${easing} group-hover:translate-x-4 group-hover:-translate-y-4 group-hover:opacity-0`}
        />
        <Icon
          name="arrow-up-right"
          aria-hidden="true"
          class={`absolute size-6 -translate-x-4 translate-y-4 text-white opacity-0 transition-all delay-[60ms] duration-500 ${easing} group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100`}
        />
      </span>
    </button>
  )
}