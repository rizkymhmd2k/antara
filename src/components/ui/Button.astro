---
import { Icon } from "astro-icon/components";
const { text } = Astro.props;
---

<button
  class="inline-flex w-fit items-center justify-between gap-4 rounded-sm bg-white px-4 py-2 sm:gap-12"
>
  <p class="text-xl  text-black sm:text-md">{text}</p>

  <div class="rounded-sm border bg-background">
    <Icon name="arrow-up-right" class="size-6 text-white" aria-hidden="true" />
  </div>
</button>
