---
import { Icon } from "astro-icon/components";
const { text } = Astro.props;
---

<button
  class="inline-flex w-fit items-center justify-between max-sm:gap-4 gap-12 rounded-sm bg-white px-4 py-2"
>
  <p class="text-2xl max-sm:text-xl font-bold text-black">{text}</p>

  <div class="rounded-sm border bg-background">
    <Icon name="arrow-up-right" class="size-6 text-white" aria-hidden="true" />
  </div>
</button>