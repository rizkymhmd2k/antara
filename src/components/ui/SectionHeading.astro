---
import Eyebrow from "./Eyebrow.astro";

const { eyebrow, title, class: className = "", as = "h2" } = Astro.props;
const HeadingTag = as;
---

<div class:list={["mb-12 flex flex-col items-start gap-2 lg:gap-4", className]}>
  <Eyebrow text={eyebrow} />
  <HeadingTag class="text-2xl leading-tight md:text-3xl lg:text-4xl">
    {title}
  </HeadingTag>
</div>
