---
import Eyebrow from "../ui/Eyebrow.astro";
import GravityRings from "../ui/GravityRings.astro";

const headline = "Built for the Weight of Wealth";
const subtext = "For clients whose capital carries consequence.";
---

<section class="hero-padding relative flex min-h-screen overflow-hidden">
  <GravityRings />
  <div class="relative z-10 flex w-full flex-col">
    <div class="flex w-full flex-col">
      <Eyebrow text="Who we are" />
      <h1 class="display-text max-w-[11ch] leading-[0.95] sm:max-w-5xl">
        {headline}
      </h1>
      <h2>{subtext}</h2>
    </div>
  </div>
</section>
