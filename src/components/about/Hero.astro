---
import Eyebrow from "../ui/Eyebrow.astro";
import GravityRings from "../ui/GravityRings.astro";
import Button from "../ui/Button.astro";
import { getEntry } from "astro:content";

const hero = await getEntry("site", "about-hero");
const data = hero?.data as {
  eyebrow: string;
  title: string;
  subtext: string;
  button: string;
};
---

<section
  class="hero-padding relative flex min-h-[100dvh] pb-[calc(10rem+env(safe-area-inset-bottom))] sm:pb-44"
>
  <GravityRings />
  <div class="relative z-10 flex w-full flex-col">
    <div class="flex w-full flex-col">
      <Eyebrow text={data.eyebrow} />
      <h1 class="display-text max-w-[11ch] leading-[0.95] sm:max-w-5xl pt-4">
        {data.title.split("\n").map((line, index) => (
          <>
            {line}
            {index < data.title.split("\n").length - 1 && <br />}
          </>
        ))}
      </h1>
      <div class="pt-4 md:pt-6 gap-2 flex flex-col">
        <h2>{data.subtext}</h2>
        <Button text={data.button} />
      </div>
    </div>
  </div>
</section>
