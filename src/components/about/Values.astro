---
import Eyebrow from "../ui/Eyebrow.astro";
import { getCollection, getEntry } from "astro:content";

const section = await getEntry("site", "about-values");
const data = section?.data as { eyebrow: string };
const items = (await getCollection("values"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section
  class="flex min-h-screen flex-col justify-between px-4 py-14 md:px-8 md:py-20 lg:py-24"
>
  <Eyebrow text={data.eyebrow} />

  <div
    class="grid grid-cols-1 divide-y divide-white/35 md:grid-cols-3 md:divide-x md:divide-y-0"
  >
    {
      items.map((item) => (
        <article class="flex min-h-72 flex-col justify-between gap-16 py-10 md:min-h-[32rem] md:px-10 md:py-28 lg:px-14">
          <span class="title-text ">{item.number}</span>

          <div>
            <h2 class="headline-text">{item.title}</h2>

            <p class="body-text mt-3">{item.body}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
