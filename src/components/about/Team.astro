---
import { Image } from "astro:assets";
import foundersImage from "../../assets/images/Founders.png";
import Eyebrow from "../ui/Eyebrow.astro";
import { getCollection, getEntry } from "astro:content";

const section = await getEntry("site", "about-team");
const data = section?.data as { eyebrow: string; title: string };
const images = {
  founders: foundersImage,
};
const members = (await getCollection("team-members"))
  .map((entry) => ({ ...entry.data, image: images[entry.data.image] }))
  .sort((a, b) => a.order - b.order);
---

<section class="container-padding grid grid-cols-1 gap-12 lg:grid-cols-12">
  <div class="lg:col-span-6">
    <Eyebrow text={data.eyebrow} />
    <h2 class="mt-4 text-[clamp(2rem,4vw,3.5rem)] leading-[0.98]">
      {data.title}
    </h2>
  </div>

  <div
    class="grid grid-cols-1 gap-6 min-[480px]:grid-cols-2 md:gap-8 lg:col-span-6"
  >
    {
      members.map((member) => (
        <article class="group flex min-w-0 flex-col gap-4">
          <div class="relative aspect-square w-full overflow-hidden rounded-sm bg-white">
            <Image
              src={member.image}
              alt={`${member.name} portrait.`}
              format="webp"
              quality={75}
              widths={[640, 960]}
              sizes="(min-width: 1024px) 18vw, (min-width: 480px) 50vw, 100vw"
              class="h-full w-full object-contain"
            />

            <div class="absolute inset-0 translate-y-full bg-gradient-to-t from-blue-600/80 via-blue-500/30 to-transparent transition-transform duration-500 ease-out group-hover:translate-y-0" />
          </div>

          <div class="space-y-2">
            <h2 class="title-text">{member.name}</h2>
            <p class="caption-text">{member.role}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
