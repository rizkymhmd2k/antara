---
import { Image } from "astro:assets";
import SectionHeading from "../ui/SectionHeading.astro"
import Jakarta from '../../assets/images/jakartaa.webp'
import Banjarmasin from '../../assets/images/bjm.webp'
import { getCollection, getEntry } from "astro:content";

const section = await getEntry("site", "about-locations");
const data = section?.data as { eyebrow: string; title: string };
const images = {
  jakarta: Jakarta,
  banjarmasin: Banjarmasin,
};
const locations = (await getCollection("locations"))
  .map((entry) => ({ ...entry.data, image: images[entry.data.image] }))
  .sort((a, b) => a.order - b.order);
---

<section class="container-padding">
  <SectionHeading eyebrow={data.eyebrow} title={data.title} />

  <div class="grid gap-6 md:grid-cols-2 md:gap-8">
    {
      locations.map((location) => (
        <article class="group space-y-4">
          <div class="relative aspect-[3/2] w-full overflow-hidden rounded-sm">
            <Image
              src={location.image}
              alt={location.alt}
              format="webp"
              quality={72}
              widths={[640, 960, 1280]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />

            <div class="absolute inset-0 translate-y-full bg-gradient-to-t from-blue-600/80 via-blue-500/30 to-transparent transition-transform duration-500 ease-out group-hover:translate-y-0" />
          </div>
          <h2 class="title-text">{location.name}</h2>
          <p class="text-sm text-muted">{location.address}</p>
        </article>
      ))
    }
  </div>
</section>
