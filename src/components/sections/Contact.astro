---
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";
import ScrollLine from "../ui/ScrollLine.astro";
import scrollLineUrl from "../../assets/lines/scroll-line-3.svg?url";
import { getEntry } from "astro:content";

const contact = await getEntry("site", "contact");
const data = contact?.data as {
  email: string;
  eyebrow: string;
  headline: string;
  button: string;
  href: string;
};
---

<section
  id="contact"
  class="container-padding relative flex flex-col gap-12 overflow-hidden sm:gap-20 md:gap-24 lg:gap-20"
>
  <ScrollLine
    src={scrollLineUrl}
    mobileEndOffset={0.7}
    class="pointer-events-none absolute inset-x-0 top-8 md:top-0 z-0 h-[min(120vh,72rem)] w-full"
    imgClass="h-[min(120vh,72rem)] w-full max-w-none "
  />
  <div class="relative z-10 flex max-w-full flex-col gap-6 sm:w-fit">
    <Eyebrow text={data.eyebrow} />

    <h1
      class="max-w-full text-[clamp(2rem,10.5vw,8rem)] leading-none [overflow-wrap:anywhere] sm:w-max"
    >
      {data.email}
    </h1>
  </div>
  <div class="relative z-10 flex w-full flex-col items-start gap-4 sm:items-end">
    <div class="flex max-w-[450px] flex-col gap-4">
      <h2 class="body-text">
        {data.headline}
      </h2>

      <div class="inline-flex flex-col gap-6">
        <Button text={data.button} href={data.href} />
      </div>
    </div>
  </div>
</section>
