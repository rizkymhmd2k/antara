---
import { Image } from "astro:assets";
import foundersImage from "../../assets/images/Founders.png";
import familyImage from "../../assets/images/family.png";
import sportsImage from "../../assets/images/tennis.png";
import executivesImage from "../../assets/images/executives.png";
import SectionHeading from "../ui/SectionHeading.astro";

const ebTitel =
  "Tailored financial guidance for life's most important decisions.";
const eyebrow = "Who we serve";
const items = [
  {
    title: "Founders",
    body: "From enterprise value to enduring personal wealth.",
    image: foundersImage,
    alt: "Two founders seated together in conversation.",
  },
  {
    title: "Families",
    body: "Clarity, continuity, and shared purpose across generations.",
    image: familyImage,
    alt: "A family spending time together outdoors.",
  },
  {
    title: "Sports & Entertainment Professionals",
    body: "Structure for uncommon careers, irregular income, and compressed opportunity windows.",
    image: sportsImage,
    alt: "A tennis player competing on court.",
  },
  {
    title: "Executives",
    body: "Guidance for concentrated equity, compensation complexity, and transition planning.",
    image: executivesImage,
    alt: "An executive in a professional office setting.",
  },
];
---

<section class="container-padding min-h-screen">
  <SectionHeading eyebrow={eyebrow} title={ebTitel} />

  <div class="grid grid-cols-1 gap-6 min-[480px]:grid-cols-2 md:gap-8 lg:grid-cols-4">
    {
      items.map((item) => (
        <article class="group flex flex-col gap-4">
          <div class="relative aspect-[4/3] w-full overflow-hidden rounded-sm">
            <Image
              src={item.image}
              alt={item.alt}
              format="webp"
              quality={75}
              widths={[640, 960]}
              sizes="(min-width: 1024px) 25vw, (min-width: 480px) 50vw, 100vw"
              class="h-full w-full object-cover"
            />

            <div class="absolute inset-0 translate-y-full bg-gradient-to-t from-blue-600/80 via-blue-500/30 to-transparent transition-transform duration-500 ease-out group-hover:translate-y-0" />
          </div>

          <div class="space-y-2">
            <h2 class="title-text">{item.title}</h2>
            <p class="caption-text">
              {item.body}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>
