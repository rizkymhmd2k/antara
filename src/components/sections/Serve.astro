---
import { Image } from "astro:assets";
import foundersImage from "../../assets/images/Founders.png";
import familyImage from "../../assets/images/family.png";
import sportsImage from "../../assets/images/tennis.png";
import executivesImage from "../../assets/images/executives.png";
import SectionHeading from "../ui/SectionHeading.astro";
import { getCollection, getEntry } from "astro:content";

const section = await getEntry("site", "home-serve");
const heading = section?.data as { eyebrow: string; title: string };
const images = {
  founders: foundersImage,
  family: familyImage,
  sports: sportsImage,
  executives: executivesImage,
};
const items = (await getCollection("audiences"))
  .map((entry) => ({ ...entry.data, image: images[entry.data.image] }))
  .sort((a, b) => a.order - b.order);
---

<section class="container-padding min-h-screen">
  <SectionHeading eyebrow={heading.eyebrow} title={heading.title} />

  <div class="grid grid-cols-1 gap-6 min-[480px]:grid-cols-2 md:gap-8 lg:grid-cols-4">
    {
      items.map((item) => (
        <article class="group flex flex-col gap-4" data-serve-card>
          <div class="relative aspect-[4/3] w-full overflow-hidden rounded-sm">
            <Image
              src={item.image}
              alt={item.alt}
              format="webp"
              quality={75}
              widths={[640, 960]}
              sizes="(min-width: 1024px) 25vw, (min-width: 480px) 50vw, 100vw"
              class="h-full w-full object-cover"
            />

            <div class="mobile-hover-overlay absolute inset-0 translate-y-full bg-gradient-to-t from-blue-600/80 via-blue-500/30 to-transparent transition-transform duration-500 ease-out group-hover:translate-y-0" />
          </div>

          <div class="space-y-2">
            <h2 class="title-text">{item.title}</h2>
            <p class="caption-text">
              {item.body}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  @media (max-width: 767px) {
    [data-serve-card].is-centered .mobile-hover-overlay {
      transform: translateY(0) !important;
    }
  }
</style>

<script>
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-serve-card]")
  );
  const mobileQuery = window.matchMedia("(max-width: 767px)");
  let frame = 0;

  const updateCenteredCard = () => {
    frame = 0;

    if (!mobileQuery.matches) {
      cards.forEach((card) => card.classList.remove("is-centered"));
      return;
    }

    const viewportCenter = window.innerHeight / 2;
    const centeredCard = cards.reduce<HTMLElement | null>((closest, card) => {
      const bounds = card.getBoundingClientRect();
      if (bounds.bottom < 0 || bounds.top > window.innerHeight) return closest;

      const closestDistance = closest
        ? Math.abs(closest.getBoundingClientRect().top + closest.getBoundingClientRect().height / 2 - viewportCenter)
        : Infinity;
      const cardDistance = Math.abs(bounds.top + bounds.height / 2 - viewportCenter);

      return cardDistance < closestDistance ? card : closest;
    }, null);

    cards.forEach((card) =>
      card.classList.toggle("is-centered", card === centeredCard)
    );
  };

  const requestCenteredCardUpdate = () => {
    if (!frame) frame = requestAnimationFrame(updateCenteredCard);
  };

  window.addEventListener("scroll", requestCenteredCardUpdate, { passive: true });
  window.addEventListener("resize", requestCenteredCardUpdate);
  mobileQuery.addEventListener("change", requestCenteredCardUpdate);
  updateCenteredCard();
</script>
