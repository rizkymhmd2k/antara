---
import antaraLogoUrl from "../../assets/icon/AntaraSVG.svg?url";
import FooterLines from "../ui/FooterLines.astro";

const socmed = [
  {
    name: "LinkedIn",
    url: "https://linkedin.com/company/yourcompany",
    icon: "linkedin",
  },
  {
    name: "Instagram",
    url: "https://instagram.com/yourcompany",
    icon: "instagram",
  },
  {
    name: "YouTube",
    url: "https://youtube.com/@yourcompany",
    icon: "youtube",
  },
  {
    name: "Facebook",
    url: "https://facebook.com/yourcompany",
    icon: "facebook",
  },
];
---

<section class="relative overflow-hidden px-4 pt-24 md:pt-48 flex flex-col gap-6">
  <FooterLines />
  <div class="relative z-10 flex justify-between">
    {
      socmed.map((item) => (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium hover:opacity-70 transition"
        >
          {item.name}
        </a>
      ))
    }
  </div>
  <img
    src={antaraLogoUrl}
    alt="Antara"
    width="1213"
    height="260"
    loading="lazy"
    decoding="async"
    class="relative z-10 w-[90%] "
  />
</section>
