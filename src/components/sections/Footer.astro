---
import antaraLogoUrl from "../../assets/icon/AntaraSVG.svg?url";
import FooterLines from "../ui/FooterLines.astro";
import { getCollection, getEntry } from "astro:content";

const footer = await getEntry("site", "footer");
const data = footer?.data as { logoAlt: string };
const socmed = (await getCollection("social-links"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section class="relative overflow-hidden px-4 pt-24 md:pt-48 flex flex-col gap-6">
  <FooterLines />
  <div class="relative z-10 flex justify-between">
    {
      socmed.map((item) => (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium hover:opacity-70 transition"
        >
          {item.name}
        </a>
      ))
    }
  </div>
  <img
    src={antaraLogoUrl}
    alt={data.logoAlt}
    width="1213"
    height="260"
    loading="lazy"
    decoding="async"
    class="relative z-10 w-[90%] "
  />
</section>
