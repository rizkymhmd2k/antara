---
import Eyebrow from "../ui/Eyebrow.astro";
const text = "Our Service";
const title = "Sophisticated planning for the future you're building.";

const servicesText = [
  {
    number: "01",
    title: "Wealth Planning",
    description: "We build a living strategy around liquidity, lifestyle, family needs, and long-term independence. As your life changes, the plan changes with it, giving each major decision a clearer financial context."
  },
  {
    number: "02",
    title: "Investment Management",
    description: "We design portfolios with a clear assignment: growth, preservation, income, access, liquidity, or resilience. Every allocation is considered in relation to the rest of your financial life, not only market performance."
  },
  {
    number: "03",
    title: "Reporting & Balance Sheet Clarity",
    description: "We organize accounts, entities, private holdings, real estate, liabilities, and cash reserves into one view. The goal is simple: make the full picture easier to understand, discuss, and act on."
  },
  {
    number: "04",
    title: "Legacy Coordination",
    description: "We help align family priorities, legal structures, beneficiaries, philanthropic intent, and investment strategy. Working alongside your outside professionals, we keep the broader wealth strategy connected to the people it is meant to serve."
  },
  {
    number: "05",
    title: "Lending & Liquidity",
    description: "We evaluate credit and liquidity solutions with restraint, context, and purpose. The aim is flexibility without weakening the long-term strength of the balance sheet."
  }
];
---

<section
  class="container-padding min-h-screen flex items-start justify-start border border-yellow-300"
>
  <div class="grid w-full gap-16 md:grid-cols-3 md:gap-x-12 md:gap-y-24">
    <div class="md:col-span-2 md:col-start-2 max-w-3xl">
      <h1 class="headline-text max-w-2xl md:text-5xl">{title}</h1>
    </div>

    <div class="md:col-span-1 md:self-start">
      <Eyebrow text={text} />
    </div>

    <div class="md:col-span-2">
      <div class="space-y-14 md:space-y-20">
        {
          servicesText.map((service) => (
            <article class="grid gap-4 sm:grid-cols-[auto_1fr] sm:gap-x-6">
              <div class="flex sm:block">
                <span
                  class="inline-flex h-8 min-w-8 items-center justify-center rounded-sm bg-white px-2 text-xs text-black"
                >
                  {service.number}
                </span>
              </div>

              <div class=" space-y-3">
                <h2 class="title-text text-2xl text-white md:text-[2.1rem] md:leading-tight">
                  {service.title}
                </h2>
                <p class=" text-sm  max-w-xl leading-snug text-white/80 md:text-base">
                  {service.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
