---
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ScrollLine from "../ui/ScrollLine.astro";
import scrollLineFourUrl from "../../assets/lines/scroll-line-4.svg?url";
import { getCollection, getEntry } from "astro:content";

const section = await getEntry("site", "home-services");
const heading = section?.data as { eyebrow: string; title: string };
const servicesText = (await getCollection("services"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<div class="relative" data-services-section data-sticky-wrapper style="visibility: hidden">

  <section
    class="container-padding relative z-10 flex items-start justify-start overflow-hidden md:sticky md:top-0 md:min-h-screen md:pt-28"
  >
    <ScrollLine
      src={scrollLineFourUrl}
      class="pointer-events-none absolute -left-[8%] top-[3%] z-0 h-[42%] w-[116%] rotate-2 opacity-75"
      imgClass="h-full w-full max-w-none"
    />

    <div class="relative z-10 grid w-full grid-cols-3 md:gap-y-8">

     <SectionHeading eyebrow={heading.eyebrow} title={heading.title} class="md:hidden col-span-3 " />


      <div
        class="hidden md:col-span-2 md:col-start-2 md:row-start-1 md:block max-w-3xl col-span-3"
      >
        <h1 class="text-4xl md:text-5xl">{heading.title}</h1>
      </div>

      <div class="hidden md:col-span-2 md:col-start-2 md:row-start-2 md:block md:self-start">
        <Eyebrow text={heading.eyebrow} />
      </div>

      <div
        class="relative col-span-3 h-auto overflow-visible sm:translate-x-[-1rem] md:col-span-2 md:col-start-2 md:row-start-3 md:h-[60vh] md:overflow-hidden"
        data-frame
      >
        <div
          aria-hidden="true"
          class="absolute bottom-0 left-4 top-0 block w-px bg-white/20 z-10"
        >
          <div
            class="w-full origin-top bg-white"
            style="height:100%; transform: scaleY(0);"
            data-line-fill
          >
          </div>
        </div>

        <div class="space-y-14 pb-10 md:space-y-32" data-track>
          {
            servicesText.map((service) => (
              <article class="grid grid-cols-[auto_minmax(0,1fr)] gap-4 gap-x-6">
                <div class="flex sm:block">
                  <span class="inline-flex h-8 min-w-8 items-center justify-center rounded-sm bg-white px-2 text-xs text-black">
                    {service.number}
                  </span>
                </div>
                <div class="min-w-0 space-y-3">
                  <h2 class="title-text text-2xl text-white md:text-[2.1rem] md:leading-tight">
                    {service.title}
                  </h2>
                  <p class="max-w-xl text-sm leading-snug text-white/80 md:text-base">
                    {service.description}
                  </p>
                </div>
              </article>
            ))
          }
          <div class="grid grid-cols-[auto_minmax(0,1fr)] gap-4 gap-x-6">
            <div class="h-8 min-w-8"></div>
            <div>
              <Button text="View services" href="/services" />
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</div>

<script>
  let cleanupServices: (() => void) | undefined;

  function initStickyServices() {
    cleanupServices?.();
    const wrapper = document.querySelector("[data-sticky-wrapper]");
    const frame = document.querySelector("[data-frame]");
    const track = document.querySelector("[data-track]");
    const lineFill = document.querySelector("[data-line-fill]");
    if (!wrapper || !frame || !track) return;

    const desktop = window.matchMedia("(min-width: 768px)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const isDesktop = () => desktop.matches;

    let maxTranslate = 0;
    let wrapperHeight = 0;
    let targetProgress = 0;
    let currentProgress = 0;
    let rafId = null;
    let visible = false;

    function measure() {
      if (isDesktop()) {
        const frameHeight = frame.clientHeight;
        const trackHeight = track.scrollHeight;
        maxTranslate = Math.max(trackHeight - frameHeight, 0);
        wrapperHeight = window.innerHeight + maxTranslate;
        wrapper.style.height = `${wrapperHeight}px`;
      } else {
        // No pinning on mobile: let the section sit in normal flow.
        maxTranslate = 0;
        wrapperHeight = 0;
        wrapper.style.height = "";
        track.style.transform = "translateY(0px)";
      }
    }

    function onScroll() {
      if (isDesktop()) {
        const rect = wrapper.getBoundingClientRect();
        const scrolled = -rect.top;
        const total = wrapperHeight - window.innerHeight;
        targetProgress =
          total > 0 ? Math.min(Math.max(scrolled / total, 0), 1) : 0;
      } else {
        // Mobile: progress is just "how far has the frame scrolled past the viewport".
        const rect = frame.getBoundingClientRect();
        const total = rect.height + window.innerHeight;
        const scrolled = window.innerHeight - rect.top;
        targetProgress =
          total > 0 ? Math.min(Math.max(scrolled / total, 0), 1) : 0;
      }
      if (!rafId && visible && !document.hidden) rafId = requestAnimationFrame(loop);
    }

    function loop() {
      rafId = null;
      if (!visible || document.hidden) return;
      const settled = reducedMotion.matches || Math.abs(targetProgress - currentProgress) < 0.0001;
      currentProgress = settled ? targetProgress : currentProgress + (targetProgress - currentProgress) * 0.15;
      if (isDesktop()) {
        track.style.transform = `translateY(${-currentProgress * maxTranslate}px)`;
      }
      if (lineFill) lineFill.style.transform = `scaleY(${currentProgress})`;
      if (!settled) rafId = requestAnimationFrame(loop);
    }

    let resizeTimer;
    function onResize() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => { measure(); onScroll(); }, 150);
    }

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) onScroll();
      else if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    });
    observer.observe(wrapper);
    const onVisibility = () => {
      if (document.hidden && rafId) { cancelAnimationFrame(rafId); rafId = null; }
      else if (visible) onScroll();
    };

    measure();
    onScroll();
    // Avoid a flash from the top before catching up to the current scroll position.
    currentProgress = targetProgress;
    wrapper.style.visibility = "visible";
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize);
    document.addEventListener("visibilitychange", onVisibility);
    reducedMotion.addEventListener("change", onScroll);
    cleanupServices = () => {
      if (rafId) cancelAnimationFrame(rafId);
      clearTimeout(resizeTimer);
      observer.disconnect();
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onResize);
      document.removeEventListener("visibilitychange", onVisibility);
      reducedMotion.removeEventListener("change", onScroll);
    };
  }

  initStickyServices();
  document.addEventListener("astro:page-load", initStickyServices);
  document.addEventListener("astro:before-swap", () => cleanupServices?.());
</script>
