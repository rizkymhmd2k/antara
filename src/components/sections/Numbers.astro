---
import ScrollLine from "../ui/ScrollLine.astro";
import numbersScrollLinesUrl from "../../assets/lines/numbers-scroll-lines.svg?url";
import { getCollection } from "astro:content";

const stats = (await getCollection("stats"))
  .map((entry) => entry.data)
  .sort((a, b) => {
    const positions: Record<number, number> = { 3: 0, 4: 1, 2: 2, 1: 3 };

    return positions[a.order] - positions[b.order];
  });
---

<section
  class="container-padding relative  overflow-hidden"
  aria-labelledby="numbers-heading"
>
  <ScrollLine
    src={numbersScrollLinesUrl}
    class="pointer-events-none absolute inset-x-0 top-0 z-0 h-44 w-full sm:h-48"
    imgClass="h-full w-full max-w-none"
  />

  <div
    class="relative z-10 grid grid-cols-1 gap-16 pt-2 md:grid-cols-2 md:gap-8 md:pt-0"
  >
    <h2
      id="numbers-heading"
      aria-label="Antara Snapshot"
      data-snapshot-scroll-fill
      class="max-w-[6ch] text-[clamp(4rem,10vw,9rem)] leading-[0.8] tracking-[-0.055em]"
    >
      <span aria-hidden="true">
        {
          Array.from("Antara").map((character) => (
            <span class="snapshot-fill-character">{character}</span>
          ))
        }
        <br />
        {
          Array.from("Snapshot").map((character) => (
            <span class="snapshot-fill-character">{character}</span>
          ))
        }
      </span>
    </h2>

    <div class="grid grid-cols-1 gap-x-8 gap-y-14 min-[480px]:grid-cols-2 md:gap-y-16 md:pt-32 lg:gap-y-20 lg:pt-28">
      {
        stats.map((stat) => (
          <div class="flex flex-col gap-4 md:gap-6">
            <h3
              class="text-center text-[clamp(3.25rem,5vw,5rem)] leading-none tracking-[-0.045em] md:text-left"
              data-countup
              data-value={stat.number}
              data-prefix={stat.prefix}
              data-suffix={stat.suffix}
            >
              {stat.value}
            </h3>
            <p class="title-text mx-auto max-w-[15rem] text-center leading-tight md:mx-0 md:text-left">
              {stat.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  let cleanupSnapshotFill: (() => void) | undefined;

  function initSnapshotFill() {
    cleanupSnapshotFill?.();

    const heading = document.querySelector<HTMLElement>(
      "[data-snapshot-scroll-fill]",
    );
    const characters = Array.from(
      heading?.querySelectorAll<HTMLElement>(".snapshot-fill-character") ?? [],
    );
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    if (!heading || !characters.length) return;

    let frame = 0;
    const fillTrail = 10;

    const update = () => {
      frame = 0;

      if (reducedMotion.matches) {
        characters.forEach((character) =>
          character.style.removeProperty("opacity"),
        );
        heading.classList.remove("snapshot-fill-ready");
        return;
      }

      heading.classList.add("snapshot-fill-ready");

      const rect = heading.getBoundingClientRect();
      const start = window.innerHeight * 0.82;
      const finish = window.innerHeight * 0.38;
      const progress = Math.min(
        1,
        Math.max(0, (start - rect.top) / (start - finish)),
      );
      const fillHead = progress * (characters.length + fillTrail);

      characters.forEach((character, index) => {
        const characterProgress = Math.min(
          1,
          Math.max(0, (fillHead - index) / fillTrail),
        );

        character.style.opacity = String(0.2 + characterProgress * 0.8);
      });
    };

    const requestUpdate = () => {
      if (frame) return;
      frame = requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    reducedMotion.addEventListener("change", requestUpdate);

    cleanupSnapshotFill = () => {
      if (frame) cancelAnimationFrame(frame);
      window.removeEventListener("scroll", requestUpdate);
      window.removeEventListener("resize", requestUpdate);
      reducedMotion.removeEventListener("change", requestUpdate);
      heading.classList.remove("snapshot-fill-ready");
      characters.forEach((character) =>
        character.style.removeProperty("opacity"),
      );
    };
  }

  initSnapshotFill();
  document.addEventListener("astro:page-load", initSnapshotFill);
  document.addEventListener("astro:before-swap", () =>
    cleanupSnapshotFill?.(),
  );

  const numbers = document.querySelectorAll<HTMLElement>("[data-countup]");

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const formatNumber = (value: number, target: number) =>
      target % 1 === 0 ? Math.round(value).toString() : value.toFixed(1);

    const animateNumber = (el: HTMLElement) => {
      const target = Number(el.dataset.value);
      const prefix = el.dataset.prefix ?? "";
      const suffix = el.dataset.suffix ?? "";
      const duration = 1200;
      const start = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);

        el.textContent = `${prefix}${formatNumber(target * eased, target)}${suffix}`;

        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          el.textContent = `${prefix}${formatNumber(target, target)}${suffix}`;
        }
      };

      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateNumber(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -40% 0px" },
    );

    numbers.forEach((number) => {
      const target = Number(number.dataset.value);
      const prefix = number.dataset.prefix ?? "";
      const suffix = number.dataset.suffix ?? "";

      number.textContent = `${prefix}${formatNumber(0, target)}${suffix}`;
      observer.observe(number);
    });
  }
</script>

<style>
  .snapshot-fill-character {
    opacity: 1;
  }

  .snapshot-fill-ready .snapshot-fill-character {
    opacity: 0.2;
  }
</style>
