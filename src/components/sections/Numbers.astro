---
import Eyebrow from "../ui/Eyebrow.astro";
import { getCollection } from "astro:content";

const stats = (await getCollection("stats"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section class="snapshot container-padding bg-surface text-background bg-grid-3 bg-grid-light pb-32" aria-labelledby="numbers-heading ">
  <div class="snapshot-heading">
    <h2 id="numbers-heading"><Eyebrow text="Antara Snapshot" /></h2>
    <p class="snapshot-intro">A focused practice.<br />A broader perspective.</p>
  </div>
  <div class="snapshot-stats">
    {
      stats.map((stat) => (
        <div class="snapshot-stat">
          <h3
            class="snapshot-value"
            aria-label={stat.value}
          >
            <span
              aria-hidden="true"
              data-countup
              data-value={stat.number}
              data-prefix={stat.prefix}
              data-suffix={stat.suffix}
            >{stat.value}</span>
          </h3>
          <p class="snapshot-label">{stat.label}</p>
        </div>
      ))
    }
  </div>
</section>

<script>
  let cleanupNumbers: (() => void) | undefined;

  function initNumbers() {
    cleanupNumbers?.();
    const numbers = document.querySelectorAll<HTMLElement>("[data-countup]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const frames = new Map<HTMLElement, number>();
    const finalValues = new Map(Array.from(numbers, (el) => [el, el.textContent]));
    const formatNumber = (value: number, target: number) =>
      target % 1 === 0 ? Math.round(value).toString() : value.toFixed(1);

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        observer.unobserve(el);
        const target = Number(el.dataset.value);
        const start = performance.now();
        const tick = (now: number) => {
          const progress = Math.min((now - start) / 1200, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = `${el.dataset.prefix ?? ""}${formatNumber(target * eased, target)}${el.dataset.suffix ?? ""}`;
          if (progress < 1) frames.set(el, requestAnimationFrame(tick));
          else frames.delete(el);
        };
        frames.set(el, requestAnimationFrame(tick));
      });
    }, { rootMargin: "0px 0px -15% 0px" });

    const restore = () => {
      observer.disconnect();
      frames.forEach((frame) => cancelAnimationFrame(frame));
      frames.clear();
      finalValues.forEach((value, el) => { el.textContent = value; });
    };
    const syncMotion = () => {
      restore();
      if (!reducedMotion.matches) numbers.forEach((el) => observer.observe(el));
    };
    syncMotion();
    reducedMotion.addEventListener("change", syncMotion);
    cleanupNumbers = () => {
      restore();
      reducedMotion.removeEventListener("change", syncMotion);
    };
  }

  initNumbers();
  document.addEventListener("astro:page-load", initNumbers);
  document.addEventListener("astro:before-swap", () => cleanupNumbers?.());
</script>

<style>
  .snapshot-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }

  .snapshot-intro {
    font-size: clamp(1.5rem, 2.5vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.045em;
  }

  .snapshot-stats {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    border-top: 1px solid rgb(0 76 187 / 15%);
  }

  .snapshot-stat {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 1.25rem clamp(1rem, 1.6vw, 2rem) 0;
    border-left: 1px solid rgb(0 76 187 / 20%);
  }

  .snapshot-stat:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .snapshot-value {
    display: flex;
    align-items: flex-end;
    min-height: clamp(9rem, 13vw, 16rem);
    font-size: clamp(3.5rem, 5.5vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .snapshot-stat:first-child .snapshot-value {
    font-size: clamp(5rem, 9vw, 12rem);
  }

  .snapshot-label {
    max-width: 13rem;
    min-height: 3em;
    margin-top: 2.5rem;
    font-size: clamp(1rem, 1.1vw, 1.25rem);
    line-height: 1.3;
  }

  @media (max-width: 47.999rem) {
    .snapshot-heading { flex-direction: column; }
    .snapshot-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .snapshot-stat { padding: 1rem 0 1.5rem 1rem; }
    .snapshot-stat:nth-child(odd) { padding-left: 0; border-left: 0; }
    .snapshot-stat:nth-child(n + 3) { border-top: 1px solid rgb(0 76 187 / 20%); }
    .snapshot-value { min-height: 7rem; font-size: clamp(3rem, 10vw, 5rem); }
    .snapshot-stat:first-child .snapshot-value { font-size: clamp(3.5rem, 12vw, 6rem); }
    .snapshot-label { margin-top: 1.5rem; padding-right: 0.5rem; }
  }
</style>
