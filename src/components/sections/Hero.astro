---
import Button from "../ui/Button.astro";
import Whitelines from "../ui/WhiteLines.astro";

const headline = "Build faster with Astro";
const subtext = "The web framework for content-driven sites.";
---

<section
  class="hero-padding relative flex min-h-screen items-end justify-start overflow-hidden"
>
  <Whitelines />
  <div class="relative z-10 flex flex-col gap-6 sm:gap-12">
    <h1 class="display-text max-w-5xl leading-[0.95]">
      Private Wealth,<br />
      Precisely Held
    </h1>

    <Button text="Get In Touch" />
  </div>
</section>
