---
import Button from "../ui/Button.astro";
import Whitelines from "../ui/WhiteLines.astro";

const headline = "Build faster with Astro";
const subtext = "The web framework for content-driven sites.";
---

<section
  class="bg-background min-h-screen flex items-end justify-start p-sm max-sm:px-xs"
>
  <Whitelines  />
  <div class="flex flex-col gap-12 max-sm:gap-6">
    <h1 class="text-hero leading-[0.95]">
      Private Wealth,<br />
      Precisely Held
    </h1>

    <Button text="Get In Touch" />
  </div>
</section>
