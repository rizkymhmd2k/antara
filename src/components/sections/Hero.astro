---
import Button from "../ui/Button.astro";
import Whitelines from "../ui/WhiteLines.astro";
import { getEntry } from "astro:content";

const hero = await getEntry("site", "home-hero");
const data = hero?.data as { headline: string; button: string; href: string };
---

<section
  class="hero-padding relative flex min-h-screen items-end justify-start overflow-hidden"
>
  <Whitelines />
  <div class="relative z-10 flex flex-col gap-6 sm:gap-12">
    <h1 class="display-text max-w-5xl leading-[0.95]">
      {data.headline.split("\n").map((line, index) => (
        <>
          {line}
          {index < data.headline.split("\n").length - 1 && <br />}
        </>
      ))}
    </h1>

    <Button
      text={data.button}
      href={data.href}
    />
  </div>
</section>
