---
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import ScrollLine from "../ui/ScrollLine.astro";
import scrollLineUrl from "../../assets/lines/scroll-line.svg?url";
import { getEntry } from "astro:content";

const who = await getEntry("site", "home-who");
const data = who?.data as {
  eyebrow: string;
  headline: string;
  button: string;
  href: string;
};
---

<section class="container-padding relative flex items-center md:pt-48">
  <ScrollLine
    src={scrollLineUrl}
    class="pointer-events-none absolute inset-x-0 top-8 md:top-25 z-0 h-[min(120vh,72rem)] w-full "
    imgClass="h-[min(120vh,72rem)] w-full max-w-none"
  />
  <div class="relative z-10 grid grid-cols-1 items-start gap-2 md:gap-12 sm:grid-cols-12 sm:gap-0">
    <!-- Eyebrow -->
    <div class="col-span-1 flex sm:col-span-3 xl:col-span-6">
      <Eyebrow text={data.eyebrow} />
    </div>

    <!-- Content -->
    <div class="col-span-1 grid gap-6 sm:col-span-8 xl:col-span-6">
      <h2 class="headline-text">
        {data.headline}
      </h2>

      <div class="flex justify-end sm:justify-start">
        <Button text={data.button} href={data.href} />
      </div>
    </div>
  </div>
</section>
