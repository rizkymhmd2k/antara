---
import Eyebrow from "../ui/Eyebrow.astro";
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";

const who = await getEntry("site", "home-who");
const data = who?.data as {
  eyebrow: string;
  headline: string;
  button: string;
  href: string;
};
---

<section class="container-padding relative flex min-h-[80svh] items-center">
  <div
    class="relative z-10 mx-auto min-h-screen justify-center flex max-w-4xl md:max-w-6xl leading-tight flex-col items-center gap-8 text-center sm:gap-10"
  >
    <!-- <div class="flex justify-center">
      <Eyebrow text={data.eyebrow} />
    </div> -->

    <h2
      aria-label={data.headline}
      data-scroll-fill
      class="max-w-[22ch] md:max-w-[24ch] text-[clamp(2rem,7vw,4.5rem)] leading-[1.05] tracking-[-0.035em]"
    >
      <span aria-hidden="true">
        {
          data.headline.split(/(\s+)/).map((word) => (
            word.trim() ? <span class="scroll-fill-word">{word}</span> : word
          ))
        }
      </span>
    </h2>

    <a
      href={data.href}
      class="group inline-flex items-center gap-2 text-lg underline decoration-white/40 underline-offset-6 transition-colors hover:decoration-white sm:text-xl"
    >
      <span>{data.button}</span>
      <Icon
        name="arrow-up-right"
        aria-hidden="true"
        class="size-5 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
      />
    </a>
  </div>
</section>

<script>
  let cleanupWhoFill: (() => void) | undefined;

  function initWhoFill() {
    cleanupWhoFill?.();

    const heading = document.querySelector<HTMLElement>("[data-scroll-fill]");
    const words = Array.from(
      heading?.querySelectorAll<HTMLElement>(".scroll-fill-word") ?? [],
    );
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    if (!heading || !words.length) return;

    let frame = 0;
    let visible = false;
    let lastFillHead = -1;
    const fillTrail = 3;
    const opacities = new Array<number>(words.length).fill(-1);

    const update = () => {
      frame = 0;

      if (reducedMotion.matches) {
        words.forEach((word) =>
          word.style.removeProperty("opacity"),
        );
        opacities.fill(-1);
        heading.classList.remove("scroll-fill-ready");
        return;
      }

      const rect = heading.getBoundingClientRect();
      const start = window.innerHeight * 0.82;
      const finish = window.innerHeight * 0.38;
      const progress = Math.min(
        1,
        Math.max(0, (start - rect.top) / (start - finish)),
      );
      const fillHead = progress * (words.length + fillTrail);
      if (fillHead === lastFillHead) return;
      lastFillHead = fillHead;

      words.forEach((word, index) => {
        const wordProgress = Math.min(
          1,
          Math.max(0, (fillHead - index) / fillTrail),
        );

        const opacity = Math.round((0.2 + wordProgress * 0.8) * 100) / 100;
        if (opacity === opacities[index]) return;
        opacities[index] = opacity;
        word.style.opacity = String(opacity);
      });
    };

    const requestUpdate = () => {
      if (frame || !visible || reducedMotion.matches || document.hidden) return;
      frame = requestAnimationFrame(update);
    };

    heading.classList.toggle("scroll-fill-ready", !reducedMotion.matches);
    update();
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) requestUpdate();
      else if (frame) { cancelAnimationFrame(frame); frame = 0; }
    });
    observer.observe(heading);
    const onMotionChange = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      lastFillHead = -1;
      heading.classList.toggle("scroll-fill-ready", !reducedMotion.matches);
      update();
    };
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    reducedMotion.addEventListener("change", onMotionChange);
    document.addEventListener("visibilitychange", requestUpdate);

    cleanupWhoFill = () => {
      if (frame) cancelAnimationFrame(frame);
      observer.disconnect();
      window.removeEventListener("scroll", requestUpdate);
      window.removeEventListener("resize", requestUpdate);
      reducedMotion.removeEventListener("change", onMotionChange);
      document.removeEventListener("visibilitychange", requestUpdate);
      heading.classList.remove("scroll-fill-ready");
      words.forEach((word) =>
        word.style.removeProperty("opacity"),
      );
    };
  }

  initWhoFill();
  document.addEventListener("astro:page-load", initWhoFill);
  document.addEventListener("astro:before-swap", () => cleanupWhoFill?.());
</script>

<style>
  .scroll-fill-word {
    opacity: 1;
  }

  .scroll-fill-ready .scroll-fill-word {
    opacity: 0.2;
  }
</style>
