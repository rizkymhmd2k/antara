---
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import ScrollLine from "../ui/ScrollLine.astro";
import scrollLineUrl from "../../assets/lines/scroll-line.svg?url";

const headline =
  "Antara Private Wealth helps clients bring order, intention, and confidence to the decisions that surround significant capital.";
---

<section class="container-padding relative flex items-center md:pt-48">
  <ScrollLine
    src={scrollLineUrl}
    class="pointer-events-none absolute inset-x-0 top-8 md:top-25 z-0 h-[min(120vh,72rem)] w-full "
    imgClass="h-[min(120vh,72rem)] w-full max-w-none"
  />
  <div class="relative z-10 items-start grid grid-cols-12 gap-12 sm:gap-0">
    <!-- Eyebrow -->
    <div class="col-span-12 flex sm:col-span-3 xl:col-span-6">
      <Eyebrow text="Who we are" />
    </div>

    <!-- Content -->
    <div class="col-span-11 grid gap-6 sm:col-span-8 xl:col-span-6">
      <h2 class="headline-text">
        {headline}
      </h2>

      <div>
        <Button text="Learn more" href="/about/" />
      </div>
    </div>
  </div>
</section>
