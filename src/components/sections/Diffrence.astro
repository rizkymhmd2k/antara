---
import SectionHeading from "../ui/SectionHeading.astro";
import { getCollection, getEntry } from "astro:content";

const section = await getEntry("site", "home-difference");
const heading = section?.data as { eyebrow: string; title: string };
const items = (await getCollection("difference-items"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section id="difference" class="difference-section">
  <div class="difference-scroll" data-difference-section>
    <div class="difference-sticky">

      <div class="difference-heading px-4 sm:px-8">
        <SectionHeading class="difference-heading-content" eyebrow={heading.eyebrow} title={heading.title} />
      </div>

      <div class="difference-viewport" data-difference-viewport>
        <div class="difference-track" data-difference-track>
          {
            items.map((item) => (
              <article class="difference-card">
                <h3 class="difference-card__title">
                  <strong>{item.number}</strong>
                  <span>{item.title}</span>
                </h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  let cleanupDifference: (() => void) | undefined;

  function initDifference() {
    cleanupDifference?.();
    const section = document.querySelector<HTMLElement>("[data-difference-section]");
    const viewport = section?.querySelector<HTMLElement>("[data-difference-viewport]");
    const track = section?.querySelector<HTMLElement>("[data-difference-track]");
    const desktop = window.matchMedia("(min-width: 48rem)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (!section || !viewport || !track) return;
    const cards = Array.from(track.querySelectorAll<HTMLElement>(".difference-card")).map((card, index) => {
      return {
        card,
        direction: index % 2 === 0 ? 1 : -1,
        rotation: [-3.5, 2.25, -1.75, 3, -2.5, 2][index % 6],
        offsetY: [2.5, -2, 1, -1.5, 2, -1][index % 6],
        top: 0,
        height: 1,
        lastMobileProgress: Number.NaN,
      };
    });
    let frame = 0;
    let active = true;
    let animationStart = 0;
    let scrollDistance = 1;
    let viewportWidth = 1;
    let startX = 0;
    let endX = 0;
    let lastProgress = -1;
    let mobileVisible = false;

    const clearMotion = () => {
      track.style.removeProperty("transform");
      cards.forEach((entry) => {
        entry.card.style.removeProperty("--scroll-rotation");
        entry.card.style.removeProperty("--card-scale");
        entry.card.style.removeProperty("--card-y");
        entry.card.style.removeProperty("z-index");
        entry.card.removeAttribute("data-active");
        entry.card.classList.remove("is-moving");
        entry.lastMobileProgress = Number.NaN;
      });
      lastProgress = -1;
    };

    const update = () => {
      frame = 0;
      if (reducedMotion.matches) {
        clearMotion();
        return;
      }
      if (!desktop.matches) {
        const center = window.scrollY + window.innerHeight * 0.52;
        cards.forEach((entry) => {
          const progress = Math.round(Math.max(-1, Math.min(1,
            (entry.top + entry.height / 2 - center) / (window.innerHeight * 0.5 + entry.height / 2),
          )) * 1000) / 1000;
          if (progress === entry.lastMobileProgress) return;
          entry.lastMobileProgress = progress;
          entry.card.classList.toggle("is-moving", Math.abs(progress) < 1);
          entry.card.style.setProperty("--scroll-rotation", `${progress * entry.direction * 2}deg`);
          entry.card.style.setProperty("--card-scale", String(1 - Math.abs(progress) * 0.035));
        });
        return;
      }
      const progress = Math.min(1, Math.max(0, (window.scrollY - animationStart) / scrollDistance));
      if (progress === lastProgress) return;
      lastProgress = progress;
      const translateX = startX + (endX - startX) * progress;
      track.style.transform = `translate3d(${translateX}px, 0, 0)`;
      const activePosition = progress * Math.max(0, cards.length - 1);
      const activeIndex = Math.round(activePosition);
      cards.forEach(({ card, rotation, offsetY }, index) => {
        const distance = Math.abs(index - activePosition);
        const focus = 1 - Math.min(1, distance);
        card.style.setProperty("--scroll-rotation", `${rotation * (1 - focus * 0.25)}deg`);
        card.style.setProperty("--card-y", `${offsetY - focus * 1.5}vh`);
        card.style.setProperty("--card-scale", String(1 + focus * 0.08));
        card.style.zIndex = String(100 - Math.round(distance * 10));
        card.toggleAttribute("data-active", index === activeIndex);
      });
    };
    const requestUpdate = () => {
      if (active && (desktop.matches || mobileVisible) && !reducedMotion.matches && !document.hidden && !frame) {
        frame = requestAnimationFrame(update);
      }
    };
    const measure = () => {
      if (!active) return;
      if (reducedMotion.matches) {
        clearMotion();
        return;
      }
      if (!desktop.matches) {
        track.style.removeProperty("transform");
        const trackTop = track.getBoundingClientRect().top + window.scrollY;
        cards.forEach((entry) => {
          entry.top = trackTop + entry.card.offsetTop;
          entry.height = entry.card.offsetHeight;
          entry.lastMobileProgress = Number.NaN;
        });
        update();
        return;
      }
      const first = cards[0]?.card;
      const last = cards.at(-1)?.card;
      if (!first || !last) return;
      viewportWidth = viewport.clientWidth;
      const sectionTop = section.getBoundingClientRect().top + window.scrollY;
      const sticky = section.querySelector<HTMLElement>(".difference-sticky");
      const animationEnd = sectionTop + section.offsetHeight - (sticky?.offsetHeight ?? window.innerHeight);
      animationStart = sectionTop;
      scrollDistance = Math.max(1, animationEnd - animationStart);
      const trackLeft = track.offsetLeft;
      startX = viewportWidth * 0.5 - trackLeft - first.offsetLeft - first.offsetWidth / 2;
      endX = viewportWidth * 0.5 - trackLeft - last.offsetLeft - last.offsetWidth / 2;
      lastProgress = -1;
      update();
    };
    const handleMotionPreference = () => {
      clearMotion();
      if (reducedMotion.matches) {
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
        clearMotion();
      } else {
        measure();
      }
    };
    const resizeObserver = new ResizeObserver(measure);
    const visibilityObserver = new IntersectionObserver(([entry]) => {
      mobileVisible = entry.isIntersecting;
      if (mobileVisible) requestUpdate();
    }, { rootMargin: "100px" });
    visibilityObserver.observe(section);
    resizeObserver.observe(section);
    resizeObserver.observe(viewport);
    cards.forEach(({ card }) => resizeObserver.observe(card));
    measure();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", measure);
    document.addEventListener("visibilitychange", requestUpdate);
    desktop.addEventListener("change", handleMotionPreference);
    reducedMotion.addEventListener("change", handleMotionPreference);
    document.fonts.ready.then(measure);
    cleanupDifference = () => {
      active = false;
      if (frame) cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      visibilityObserver.disconnect();
      window.removeEventListener("scroll", requestUpdate);
      window.removeEventListener("resize", measure);
      document.removeEventListener("visibilitychange", requestUpdate);
      desktop.removeEventListener("change", handleMotionPreference);
      reducedMotion.removeEventListener("change", handleMotionPreference);
      clearMotion();
    };
  }

  initDifference();
  document.addEventListener("astro:page-load", initDifference);
  document.addEventListener("astro:before-swap", () => cleanupDifference?.());
</script>

<style>
  .difference-section {
    position: relative;
    min-width: 0;
  }

  .difference-sticky {
    position: relative;
    isolation: isolate;
    min-width: 0;
  }

  .difference-rails {
    display: none;
  }

  .difference-heading {
    position: relative;
    z-index: 2;
    padding-top: 4rem;
    padding-bottom: 0;
    text-align: center;
  }

  .difference-heading :global(.difference-heading-content) {
    align-items: center;
    margin-bottom: 0;
  }

  .difference-heading :global(h2) {
    max-width: 24ch;
    font-size: clamp(2rem, 4.8vw, 5rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .difference-viewport {
    position: relative;
    z-index: 1;
    min-width: 0;
    overflow: visible;
    padding: 1rem 1rem 3.5rem;
  }

  .difference-viewport::-webkit-scrollbar {
    display: none;
  }

  .difference-track {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 5rem;
  }

  .difference-card {
    --hole-left: 1.5rem;
    --fold-size: clamp(1.75rem, 3vw, 2.75rem);
    position: relative;
    display: flex;
    width: 85%;
    min-height: 16rem;
    flex: 0 0 auto;
    flex-direction: column;
    justify-content: flex-start;
    padding: 2.75rem 1.5rem 3.25rem;
    color: var(--color-background);
    background: #faf9f4;
    border-radius: 0.4rem;
    clip-path: polygon(
      0 0,
      calc(100% - var(--fold-size)) 0,
      100% var(--fold-size),
      100% 100%,
      0 100%
    );
    mask-image: radial-gradient(
      circle at calc(var(--hole-left) + 7px) calc(1.25rem + 7px),
      transparent 6.5px,
      black 7.5px
    );
  }

  .difference-card::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: var(--fold-size);
    height: var(--fold-size);
    background: #e2e4dc;
    clip-path: polygon(0 0, 100% 100%, 0 100%);
    pointer-events: none;
  }

  .difference-card__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
    font-weight: 500;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.05;
  }

  .difference-card__title strong {
    width: 100%;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1rem;
    font-weight: 400;
    font-size: clamp(2rem, 3.2vw, 3rem);
    line-height: 0.85;
  }

  .difference-card p {
    max-width: 34ch;
    padding-top: 1.75rem;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.3;
  }

  @media (max-width: 47.999rem) {
    .difference-card {
      align-self: center;
      width: 80%;
    }

    .difference-heading {
      padding-bottom: 2.8rem;
    }

  }

  @media (max-width: 47.999rem) and (prefers-reduced-motion: no-preference) {
    .difference-card {
      transform: rotate(var(--scroll-rotation, 0deg))
        scale(var(--card-scale, 1));
      transform-origin: center;
      backface-visibility: hidden;
    }

    .difference-card.is-moving {
      will-change: transform;
    }
  }

  @media (min-width: 48rem) {
    .difference-heading :global(h2) {
      max-width: none;
      font-size: clamp(1.5rem, 3.5vw, 5rem);
      white-space: nowrap;
    }

    .difference-scroll {
      height: 340vh;
    }

    .difference-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      height: max(100svh, 48rem);
      overflow: hidden;
    }

    .difference-heading {
      position: absolute;
      top: 10%;
      right: 0;
      left: 0;
      padding-top: 0;
    }

    .difference-rails {
      position: absolute;
      inset: 0;
      z-index: 0;
      display: block;
      pointer-events: none;
      background-image:
        linear-gradient(to bottom, var(--grid-line-color), var(--grid-line-color)),
        linear-gradient(to bottom, var(--grid-line-color), var(--grid-line-color));
      background-position:
        0 43%,
        0 82%;
      background-repeat: no-repeat;
      background-size: 100% 1px;
    }

    .difference-viewport {
      position: absolute;
      inset: 37% 0 14%;
      display: flex;
      align-items: center;
      overflow: visible;
      z-index: 1;
      padding: 0 5vw;
      scroll-snap-type: none;
    }

    .difference-track {
      position: relative;
      top: 0;
      width: max-content;
      flex-direction: row;
      align-items: center;
      gap: clamp(3rem, 4vw, 5rem);
      will-change: transform;
    }

    .difference-card {
      width: clamp(15rem, 20vw, 23rem);
      min-width: 0;
      max-width: none;
      min-height: clamp(22rem, 26vw, 30rem);
      justify-content: flex-start;
      padding: 3.5rem clamp(1.35rem, 1.8vw, 2rem) 2rem;
      scroll-snap-align: none;
      transform: translateY(var(--card-y, 0)) scale(var(--card-scale, 1)) rotate(var(--scroll-rotation, 0deg));
      transform-origin: center;
      will-change: transform;
    }

    .difference-card {
      --hole-left: clamp(1.35rem, 2vw, 2rem);
    }

  }

  @media (min-width: 48rem) and (prefers-reduced-motion: reduce) {
    .difference-scroll {
      height: auto;
    }

    .difference-sticky {
      position: relative;
      height: auto;
      overflow: visible;
    }

    .difference-heading {
      position: relative;
      top: auto;
      padding-top: 4rem;
      padding-bottom: 0;
    }

    .difference-rails {
      display: none;
    }

    .difference-viewport {
      position: relative;
      inset: auto;
      display: block;
      overflow-x: auto;
      padding: 1rem 1rem 3.5rem;
      scroll-snap-type: x mandatory;
    }

    .difference-track {
      gap: 5rem;
      top: 0;
      transform: none;
    }

    .difference-card {
      width: min(82vw, 36rem);
      min-width: 0;
      min-height: 17rem;
      transform: none;
      opacity: 1;
      filter: none;
      scroll-snap-align: center;
    }

  }
</style>
