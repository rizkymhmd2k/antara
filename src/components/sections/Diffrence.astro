---
import SectionHeading from "../ui/SectionHeading.astro";
import { getCollection, getEntry } from "astro:content";

const section = await getEntry("site", "home-difference");
const heading = section?.data as { eyebrow: string; title: string };
const items = (await getCollection("difference-items"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section id="difference" class="difference-section" data-difference-section>
  <div class="difference-sticky">
    <div class="difference-heading container-padding">
      <SectionHeading eyebrow={heading.eyebrow} title={heading.title} />
    </div>

    <div class="difference-viewport" data-difference-viewport>
      <div class="difference-track" data-difference-track>
        {
          items.map((item) => (
            <article class="difference-card">
              <h2 class="difference-card__title">
                <strong>{item.number}</strong>
                <span>{item.title}</span>
              </h2>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  let cleanupDifference: (() => void) | undefined;

  function initDifference() {
    cleanupDifference?.();

    const section = document.querySelector<HTMLElement>(
      "[data-difference-section]",
    );
    const viewport = section?.querySelector<HTMLElement>(
      "[data-difference-viewport]",
    );
    const track = section?.querySelector<HTMLElement>(
      "[data-difference-track]",
    );
    const cards = Array.from(
      section?.querySelectorAll<HTMLElement>(".difference-card") ?? [],
    );
    const desktop = window.matchMedia("(min-width: 48rem)");
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    if (!section || !viewport || !track || !cards.length) return;

    let frame = 0;

    const update = () => {
      frame = 0;

      if (reducedMotion.matches) {
        track.style.removeProperty("transform");
        cards.forEach((card) => card.style.removeProperty("transform"));
        return;
      }

      if (!desktop.matches) {
        track.style.removeProperty("transform");

        cards.forEach((card, index) => {
          const rect = card.getBoundingClientRect();
          const center = rect.top + rect.height / 2;
          const distance = Math.min(
            1,
            Math.max(-1, (center - window.innerHeight / 2) / window.innerHeight),
          );
          const centerDistance = Math.min(
            1,
            Math.max(
              0,
              (center - window.innerHeight / 2) / (window.innerHeight / 2),
            ),
          );
          const easedCenterDistance =
            centerDistance * centerDistance * (3 - 2 * centerDistance);
          const direction = index % 2 === 0 ? 1 : -1;
          const rotation = Math.max(0, distance) * direction * 6;
          const scale = 1.04 - easedCenterDistance * 0.1;

          card.style.transform = `rotate(${rotation}deg) scale(${scale})`;
        });
        return;
      }

      const rect = section.getBoundingClientRect();
      const scrollDistance = section.offsetHeight - window.innerHeight;
      const progress = Math.min(1, Math.max(0, -rect.top / scrollDistance));
      const viewportWidth = viewport.clientWidth;
      const firstCard = cards[0];
      const lastCard = cards.at(-1)!;
      const trackOrigin = track.offsetLeft;
      const firstCenter =
        trackOrigin + firstCard.offsetLeft + firstCard.offsetWidth / 2;
      const lastCenter =
        trackOrigin + lastCard.offsetLeft + lastCard.offsetWidth / 2;
      const startX = viewportWidth * 0.58 - firstCenter;
      const endX = viewportWidth * 0.74 - lastCenter;
      const trackX = startX + (endX - startX) * progress;

      track.style.transform = `translate3d(${trackX}px, 0, 0)`;

      cards.forEach((card, index) => {
        const center =
          trackOrigin + trackX + card.offsetLeft + card.offsetWidth / 2;
        const distance = Math.min(
          1,
          Math.max(-1, (center - viewportWidth / 2) / (viewportWidth / 2)),
        );
        const amount = Math.max(0, distance);
        const easedAmount = amount * amount * (3 - 2 * amount);
        const centerDistance = Math.abs(distance);
        const easedCenterDistance =
          centerDistance * centerDistance * (3 - 2 * centerDistance);
        const rotation = -easedAmount * 5;
        const baseY = [6, -5, 4, -6, 5, -4][index % 6];
        const floatY = Math.sin(distance * Math.PI) * 2;
        const scale = 1.08 - easedCenterDistance * 0.18;

        card.style.transform = `translate3d(0, ${baseY + floatY}vh, 0) rotate(${rotation}deg) scale(${scale})`;
      });
    };

    const requestUpdate = () => {
      if (frame) return;
      frame = requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    desktop.addEventListener("change", requestUpdate);
    reducedMotion.addEventListener("change", requestUpdate);

    cleanupDifference = () => {
      if (frame) cancelAnimationFrame(frame);
      window.removeEventListener("scroll", requestUpdate);
      window.removeEventListener("resize", requestUpdate);
      desktop.removeEventListener("change", requestUpdate);
      reducedMotion.removeEventListener("change", requestUpdate);
      track.style.removeProperty("transform");
      cards.forEach((card) => card.style.removeProperty("transform"));
    };

    document.fonts.ready.then(requestUpdate);
  }

  initDifference();
  document.addEventListener("astro:page-load", initDifference);
  document.addEventListener("astro:before-swap", () => cleanupDifference?.());
</script>

<style>
  .difference-section {
    position: relative;
    min-width: 0;
  }

  .difference-sticky {
    min-width: 0;
  }

  .difference-heading {
    padding-bottom: 2rem;
  }

  .difference-viewport {
    min-width: 0;
    overflow: visible;
    padding: 1rem 1rem 3.5rem;
  }

  .difference-viewport::-webkit-scrollbar {
    display: none;
  }

  .difference-track {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 5rem;
  }

  .difference-card {
    position: relative;
    display: flex;
    width: 85%;
    min-height: 0;
    flex: 0 0 auto;
    flex-direction: column;
    justify-content: flex-start;
    padding: 1.35rem 1.5rem 3.25rem;
    color: var(--color-background);
    background: white;
    will-change: transform;
  }

  .difference-card::after {
    content: "";
    position: absolute;
    right: 1.5rem;
    bottom: 1.25rem;
    left: 1.5rem;
    border-top: 1px solid currentColor;
  }

  .difference-card__title {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.45rem;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.05;
  }

  .difference-card__title strong {
    font-weight: 700;
  }

  .difference-card p {
    max-width: 34ch;
    padding-top: 0.75rem;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.08;
  }

  @media (max-width: 47.999rem) {
    .difference-heading {
      padding-top: 1.5rem;
    }
  }

  @media (min-width: 48rem) {
    .difference-section {
      height: 460vh;
    }

    .difference-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      overflow: hidden;
    }

    .difference-heading {
      position: relative;
      z-index: 1;
      padding-bottom: 0;
    }

    .difference-viewport {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      overflow: visible;
      padding: 8rem 5vw 0;
      scroll-snap-type: none;
    }

    .difference-track {
      width: max-content;
      flex-direction: row;
      align-items: center;
      gap: 8vw;
      will-change: transform;
    }

    .difference-card {
      width: 30vw;
      min-width: 19rem;
      max-width: 31rem;
      min-height: clamp(12rem, 17vw, 15.5rem);
      justify-content: center;
      padding: clamp(1.35rem, 2vw, 2rem);
      scroll-snap-align: none;
    }

    .difference-card::after {
      right: clamp(1.35rem, 2vw, 2rem);
      bottom: clamp(1.1rem, 1.4vw, 1.4rem);
      left: clamp(1.35rem, 2vw, 2rem);
    }
  }

  @media (min-width: 48rem) and (prefers-reduced-motion: reduce) {
    .difference-section {
      height: auto;
    }

    .difference-sticky {
      position: relative;
      height: auto;
      overflow: visible;
    }

    .difference-heading {
      padding-bottom: 2rem;
    }

    .difference-viewport {
      position: relative;
      display: block;
      overflow-x: auto;
      padding: 1rem 1rem 3.5rem;
      scroll-snap-type: x mandatory;
    }

    .difference-track {
      gap: 5rem;
      transform: none;
    }

    .difference-card {
      width: min(82vw, 25rem);
      min-width: 0;
      min-height: 13.5rem;
      transform: none;
      scroll-snap-align: center;
    }
  }
</style>
