---
import SectionHeading from "../ui/SectionHeading.astro";
import { getCollection, getEntry } from "astro:content";

const section = await getEntry("site", "home-difference");
const heading = section?.data as { eyebrow: string; title: string };
const items = (await getCollection("difference-items"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section id="difference" class="difference-section">
  <div class="difference-heading container-padding">
    <SectionHeading class="difference-heading-content" eyebrow={heading.eyebrow} title={heading.title} />
  </div>

  <div class="difference-scroll" data-difference-section>
  <div class="difference-sticky">
    <div class="difference-rails" aria-hidden="true"></div>

    <div class="difference-viewport" data-difference-viewport>
      <div class="difference-track" data-difference-track>
        {
          items.map((item) => (
            <article class="difference-card">
              <h2 class="difference-card__title">
                <strong>{item.number}</strong>
                <span>{item.title}</span>
              </h2>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
  </div>
</section>

<script>
  let cleanupDifference: (() => void) | undefined;

  function initDifference() {
    cleanupDifference?.();
    const section = document.querySelector<HTMLElement>("[data-difference-section]");
    const viewport = section?.querySelector<HTMLElement>("[data-difference-viewport]");
    const track = section?.querySelector<HTMLElement>("[data-difference-track]");
    const desktop = window.matchMedia("(min-width: 48rem)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (!section || !viewport || !track) return;
    const cards = Array.from(track.querySelectorAll<HTMLElement>(".difference-card")).map((card, index) => {
      const seed = Math.sin((index + 1) * 127.1) * 43758.5453;
      const variation = seed - Math.floor(seed);
      return {
        card,
        variation,
        direction: index % 2 === 0 ? 1 : -1,
        phase: variation * Math.PI * 2,
      };
    });
    let frame = 0;
    let active = true;
    let animationStart = 0;
    let scrollDistance = 1;
    let viewportWidth = 1;
    let startX = 0;
    let endX = 0;
    let lastProgress = -1;

    const clearMotion = () => {
      track.style.removeProperty("transform");
      cards.forEach(({ card }) => card.style.removeProperty("--scroll-rotation"));
      lastProgress = -1;
    };

    const update = () => {
      frame = 0;
      if (!desktop.matches || reducedMotion.matches) {
        clearMotion();
        return;
      }
      const progress = Math.min(1, Math.max(0, (window.scrollY - animationStart) / scrollDistance));
      if (progress === lastProgress) return;
      lastProgress = progress;
      const translateX = startX + (endX - startX) * progress;
      track.style.transform = `translate3d(${translateX}px, 0, 0)`;
      cards.forEach(({ card, variation, direction, phase }) => {
        const magnitude = 5 + variation * 1.2 + Math.sin(progress * Math.PI * 2 + phase) * 2.2;
        const rotation = direction * magnitude;
        card.style.setProperty("--scroll-rotation", `${rotation}deg`);
      });
    };
    const requestUpdate = () => {
      if (active && desktop.matches && !reducedMotion.matches && !frame) {
        frame = requestAnimationFrame(update);
      }
    };
    const measure = () => {
      if (!active) return;
      if (!desktop.matches || reducedMotion.matches) {
        clearMotion();
        return;
      }
      const first = cards[0]?.card;
      const last = cards.at(-1)?.card;
      if (!first || !last) return;
      viewportWidth = viewport.clientWidth;
      const sectionTop = section.getBoundingClientRect().top + window.scrollY;
      const animationEnd = sectionTop + section.offsetHeight - window.innerHeight * 0.7;
      animationStart = sectionTop - window.innerHeight * 0.2;
      scrollDistance = Math.max(1, animationEnd - animationStart);
      const trackLeft = track.offsetLeft;
      startX = viewportWidth * 0.5 - trackLeft - first.offsetLeft - first.offsetWidth / 2;
      endX = viewportWidth * 0.5 - trackLeft - last.offsetLeft - last.offsetWidth / 2;
      lastProgress = -1;
      update();
    };
    const handleMotionPreference = () => {
      if (!desktop.matches || reducedMotion.matches) {
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
        clearMotion();
      } else {
        measure();
      }
    };
    const resizeObserver = new ResizeObserver(measure);
    resizeObserver.observe(section);
    resizeObserver.observe(viewport);
    cards.forEach(({ card }) => resizeObserver.observe(card));
    measure();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", measure);
    desktop.addEventListener("change", handleMotionPreference);
    reducedMotion.addEventListener("change", handleMotionPreference);
    document.fonts.ready.then(measure);
    cleanupDifference = () => {
      active = false;
      if (frame) cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      window.removeEventListener("scroll", requestUpdate);
      window.removeEventListener("resize", measure);
      desktop.removeEventListener("change", handleMotionPreference);
      reducedMotion.removeEventListener("change", handleMotionPreference);
      clearMotion();
    };
  }

  initDifference();
  document.addEventListener("astro:page-load", initDifference);
  document.addEventListener("astro:before-swap", () => cleanupDifference?.());
</script>

<style>
  .difference-section {
    position: relative;
    min-width: 0;
  }

  .difference-sticky {
    position: relative;
    isolation: isolate;
    min-width: 0;
  }

  .difference-rails {
    display: none;
  }

  .difference-heading {
    position: relative;
    z-index: 1;
    padding-bottom: 0;
    text-align: center;
  }

  .difference-heading :global(.difference-heading-content) {
    align-items: center;
    margin-bottom: 0;
  }

  .difference-heading :global(h2) {
    max-width: 22ch;
    font-size: clamp(2rem, 4.5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .difference-viewport {
    position: relative;
    z-index: 1;
    min-width: 0;
    overflow: visible;
    padding: 1rem 1rem 3.5rem;
  }

  .difference-viewport::-webkit-scrollbar {
    display: none;
  }

  .difference-track {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 5rem;
  }

  .difference-card {
    --hole-left: 1.5rem;
    position: relative;
    display: flex;
    width: 85%;
    min-height: 16rem;
    flex: 0 0 auto;
    flex-direction: column;
    justify-content: flex-start;
    padding: 2.75rem 1.5rem 3.25rem;
    color: var(--color-background);
    background: white;
    mask-image: radial-gradient(
      circle at calc(var(--hole-left) + 7px) calc(1.25rem + 7px),
      transparent 6.5px,
      black 7.5px
    );
  }

  .difference-card::after {
    content: "";
    position: absolute;
    right: 1.5rem;
    bottom: 1.25rem;
    left: 1.5rem;
    border-top: 1px solid currentColor;
  }

  .difference-card__title {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.45rem;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.05;
  }

  .difference-card__title strong {
    font-weight: 700;
  }

  .difference-card p {
    max-width: 34ch;
    padding-top: 0.75rem;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.08;
  }

  @media (max-width: 47.999rem) {
    .difference-card:nth-child(odd) { align-self: flex-start; width: 96%; }
    .difference-card:nth-child(even) { align-self: flex-end; width: 90%; }

    .difference-heading {
      padding-top: 1.5rem;
    }

  }

  @media (min-width: 48rem) {
    .difference-scroll {
      height: 460vh;
    }

    .difference-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      overflow: hidden;
    }

    .difference-rails {
      position: absolute;
      inset: 0;
      z-index: 0;
      display: block;
      pointer-events: none;
      background-image:
        linear-gradient(to bottom, var(--grid-line-color), var(--grid-line-color)),
        linear-gradient(to bottom, var(--grid-line-color), var(--grid-line-color));
      background-position:
        0 40%,
        0 78%;
      background-repeat: no-repeat;
      background-size: 100% 1px;
    }

    .difference-viewport {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      overflow: visible;
      z-index: 1;
      padding: 0 5vw;
      scroll-snap-type: none;
    }

    .difference-track {
      position: relative;
      top: 0;
      width: max-content;
      flex-direction: row;
      align-items: center;
      gap: 8vw;
      will-change: transform;
    }

    .difference-card {
      width: 40vw;
      min-width: 23rem;
      max-width: 40rem;
      min-height: clamp(17rem, 23vw, 21rem);
      justify-content: center;
      padding: clamp(1.35rem, 2vw, 2rem);
      padding-top: clamp(2.75rem, 3.5vw, 3.5rem);
      scroll-snap-align: none;
      will-change: transform;
    }

    .difference-card:nth-child(3n + 1) {
      transform: translateY(7vh) scale(1.08) rotate(var(--scroll-rotation, 0deg));
    }

    .difference-card:nth-child(3n + 2) {
      transform: translateY(-6vh) scale(0.92) rotate(var(--scroll-rotation, 0deg));
    }

    .difference-card:nth-child(3n) {
      transform: translateY(2vh) scale(1.02) rotate(var(--scroll-rotation, 0deg));
    }

    .difference-card {
      --hole-left: clamp(1.35rem, 2vw, 2rem);
    }

    .difference-card::after {
      right: clamp(1.35rem, 2vw, 2rem);
      bottom: clamp(1.1rem, 1.4vw, 1.4rem);
      left: clamp(1.35rem, 2vw, 2rem);
    }
  }

  @media (min-width: 48rem) and (prefers-reduced-motion: reduce) {
    .difference-scroll {
      height: auto;
    }

    .difference-sticky {
      position: relative;
      height: auto;
      overflow: visible;
    }

    .difference-heading {
      position: relative;
      padding-bottom: 0;
    }

    .difference-rails {
      display: none;
    }

    .difference-viewport {
      position: relative;
      display: block;
      overflow-x: auto;
      padding: 1rem 1rem 3.5rem;
      scroll-snap-type: x mandatory;
    }

    .difference-track {
      gap: 5rem;
      top: 0;
      transform: none;
    }

    .difference-card {
      width: min(82vw, 36rem);
      min-width: 0;
      min-height: 17rem;
      transform: none;
      scroll-snap-align: center;
    }
  }
</style>
