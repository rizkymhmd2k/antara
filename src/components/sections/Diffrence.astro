---
import SectionHeading from "../ui/SectionHeading.astro";
import { getCollection, getEntry } from "astro:content";

const section = await getEntry("site", "home-difference");
const heading = section?.data as { eyebrow: string; title: string };
const items = (await getCollection("difference-items"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section class="container-padding">
  <SectionHeading eyebrow={heading.eyebrow} title={heading.title} />

  <div class="difference-grid grid grid-cols-1 sm:grid-cols-3">
    {
      items.map((item) => (
        <article class="flex min-h-72 flex-col justify-between gap-10 p-6 sm:p-8 xl:min-h-80">
          <span class="headline-text">{item.number}</span>
          <div>
            <h2 class="title-text">{item.title}</h2>
            <p class="body-text mt-4">{item.body}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .difference-grid > * + * {
    border-top: 1px solid rgb(255 255 255 / 0.35);
  }

  @media (min-width: 40rem) {
    .difference-grid > * + * {
      border-top: 0;
    }

    .difference-grid > *:nth-child(n + 4) {
      border-top: 1px solid rgb(255 255 255 / 0.35);
    }

    .difference-grid > *:not(:nth-child(3n + 1)) {
      border-left: 1px solid rgb(255 255 255 / 0.35);
    }
  }
</style>
