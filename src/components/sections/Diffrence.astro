---
import SectionHeading from "../ui/SectionHeading.astro";

const ebTitel = "A Different Standard of Wealth Advisory";
const eyebrow = "Our Difference";
const items = [
  {
    number: "01",
    title: "Fiduciary, always",
    body: "Legally and ethically bound to put your interests first every recommendation, every day. No exceptions.",
  },
  {
    number: "02",
    title: "We invest our own capital",
    body: "Every strategy we recommend is one we believe in enough to invest our own money alongside yours.",
  },
  {
    number: "01",
    title: "Institutional access",
    body: "Over 25 years building private market relationships delivering institutional-grade alternatives to individual portfolios.",
  },
  {
    number: "01",
    title: "Fiduciary, always",
    body: "Legally and ethically bound to put your interests first every recommendation, every day. No exceptions.",
  },
  {
    number: "02",
    title: "We invest our own capital",
    body: "Every strategy we recommend is one we believe in enough to invest our own money alongside yours.",
  },
  {
    number: "01",
    title: "Institutional access",
    body: "Over 25 years building private market relationships delivering institutional-grade alternatives to individual portfolios.",
  },
];
---

<section class="container-padding">
  <SectionHeading eyebrow={eyebrow} title={ebTitel} />

  <div class="difference-grid grid grid-cols-1 sm:grid-cols-3">
    {
      items.map((item) => (
        <article class="flex min-h-72 flex-col justify-between gap-10 p-6 sm:p-8 xl:min-h-80">
          <span class="headline-text">{item.number}</span>
          <div>
            <h2 class="title-text">{item.title}</h2>
            <p class="body-text mt-4">{item.body}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .difference-grid > * + * {
    border-top: 1px solid rgb(255 255 255 / 0.35);
  }

  @media (min-width: 40rem) {
    .difference-grid > * + * {
      border-top: 0;
    }

    .difference-grid > *:nth-child(n + 4) {
      border-top: 1px solid rgb(255 255 255 / 0.35);
    }

    .difference-grid > *:not(:nth-child(3n + 1)) {
      border-left: 1px solid rgb(255 255 255 / 0.35);
    }
  }
</style>
