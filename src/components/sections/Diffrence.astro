---
import SectionHeading from "../ui/SectionHeading.astro";
import { getCollection, getEntry } from "astro:content";

const section = await getEntry("site", "home-difference");
const heading = section?.data as { eyebrow: string; title: string };
const items = (await getCollection("difference-items"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section id="difference" class="difference-section" data-difference-section>
  <div class="difference-sticky">
    <div class="difference-rails" aria-hidden="true"></div>

    <div class="difference-heading container-padding">
      <SectionHeading eyebrow={heading.eyebrow} title={heading.title} />
    </div>

    <div class="difference-viewport" data-difference-viewport>
      <div class="difference-track" data-difference-track>
        {
          items.map((item) => (
            <article class="difference-card">
              <h2 class="difference-card__title">
                <strong>{item.number}</strong>
                <span>{item.title}</span>
              </h2>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  let cleanupDifference: (() => void) | undefined;

  function initDifference() {
    cleanupDifference?.();

    const section = document.querySelector<HTMLElement>(
      "[data-difference-section]",
    );
    const viewport = section?.querySelector<HTMLElement>(
      "[data-difference-viewport]",
    );
    const track = section?.querySelector<HTMLElement>(
      "[data-difference-track]",
    );
    const cards = Array.from(
      section?.querySelectorAll<HTMLElement>(".difference-card") ?? [],
    );
    const desktop = window.matchMedia("(min-width: 48rem)");
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    if (!section || !viewport || !track || !cards.length) return;

    const clamp = (value: number, min: number, max: number) =>
      Math.min(max, Math.max(min, value));
    const easeOutCubic = (value: number) => 1 - Math.pow(1 - value, 3);
    const motions = cards.map(() => ({
      targetY: 0,
      targetRotateX: 0,
      targetRotateY: 0,
      targetRotateZ: 0,
      targetScale: 1,
      currentY: 0,
      currentRotateX: 0,
      currentRotateY: 0,
      currentRotateZ: 0,
      currentScale: 1,
    }));
    const trackMotion = { targetX: 0, currentX: 0 };

    let frame = 0;
    let animationFrame = 0;
    let previousTime = performance.now();
    let active = true;

    const setMobileTargets = () => {
      const viewportHeight = window.innerHeight || 1;
      const trackTop = track.getBoundingClientRect().top;

      cards.forEach((card, index) => {
        const motion = motions[index];
        const center = trackTop + card.offsetTop + card.offsetHeight / 2;
        const entry = clamp(
          (viewportHeight * 0.9 - center) / (viewportHeight * 0.4),
          0,
          1,
        );
        const exit = clamp(
          (viewportHeight * 0.5 - center) / (viewportHeight * 0.6),
          0,
          1,
        );
        const easedEntry = easeOutCubic(entry);
        const easedExit = easeOutCubic(exit);
        const direction = index % 2 === 0 ? 1 : -1;

        motion.targetY =
          viewportHeight * 0.35 * (1 - easedEntry) -
          viewportHeight * 0.06 * easedExit;
        motion.targetRotateX = 45 * (1 - easedEntry);
        motion.targetRotateY = 0;
        motion.targetRotateZ = direction * 5 * (1 - easedEntry);
        motion.targetScale =
          1.06 - 0.06 * easedEntry - 0.06 * easedExit;
      });
    };

    const setDesktopTargets = () => {
      const rect = section.getBoundingClientRect();
      const scrollDistance = section.offsetHeight - window.innerHeight;
      const progress = clamp(-rect.top / scrollDistance, 0, 1);
      const viewportWidth = viewport.clientWidth;
      const viewportHeight = viewport.clientHeight;
      const firstCard = cards[0];
      const lastCard = cards.at(-1)!;
      const trackOrigin = track.offsetLeft;
      const firstCenter =
        trackOrigin + firstCard.offsetLeft + firstCard.offsetWidth / 2;
      const lastCenter =
        trackOrigin + lastCard.offsetLeft + lastCard.offsetWidth / 2;
      const startX = viewportWidth * 0.58 - firstCenter;
      const endX = viewportWidth * 0.74 - lastCenter;

      trackMotion.targetX = startX + (endX - startX) * progress;

      cards.forEach((card, index) => {
        const motion = motions[index];
        const center =
          trackOrigin +
          trackMotion.targetX +
          card.offsetLeft +
          card.offsetWidth / 2;
        const distance = clamp(
          (center - viewportWidth / 2) / (viewportWidth / 2),
          -1,
          1,
        );
        const entry = easeOutCubic(Math.max(0, distance));
        const exit = easeOutCubic(Math.max(0, -distance));
        const direction = index % 2 === 0 ? 1 : -1;
        const rail = index % 2 === 0 ? 0.78 : 0.66;
        const cardBottom = track.offsetTop + card.offsetTop + card.offsetHeight;
        const railY = viewportHeight * rail - cardBottom;

        motion.targetY =
          railY + viewportHeight * 0.12 * entry - viewportHeight * 0.05 * exit;
        motion.targetRotateX = 0;
        motion.targetRotateY = -35 * entry + 10 * exit;
        motion.targetRotateZ = direction * 4 * entry;
        motion.targetScale = 1.06 - 0.05 * entry - 0.1 * exit;
      });
    };

    const renderMotion = (time: number) => {
      const elapsed = Math.min(time - previousTime, 64);
      const smoothing = 1 - Math.pow(0.86, elapsed / (1000 / 60));
      let unsettled = false;

      previousTime = time;
      if (desktop.matches) {
        trackMotion.currentX +=
          (trackMotion.targetX - trackMotion.currentX) * smoothing;
        track.style.transform = `translate3d(${trackMotion.currentX}px, 0, 0)`;
        if (Math.abs(trackMotion.targetX - trackMotion.currentX) > 0.02) {
          unsettled = true;
        }
      }

      motions.forEach((motion, index) => {
        motion.currentY += (motion.targetY - motion.currentY) * smoothing;
        motion.currentRotateX +=
          (motion.targetRotateX - motion.currentRotateX) * smoothing;
        motion.currentRotateY +=
          (motion.targetRotateY - motion.currentRotateY) * smoothing;
        motion.currentRotateZ +=
          (motion.targetRotateZ - motion.currentRotateZ) * smoothing;
        motion.currentScale +=
          (motion.targetScale - motion.currentScale) * smoothing;

        cards[index].style.transform =
          `translate3d(0, ${motion.currentY}px, 0) ` +
          `rotateX(${motion.currentRotateX}deg) ` +
          `rotateY(${motion.currentRotateY}deg) ` +
          `rotateZ(${motion.currentRotateZ}deg) ` +
          `scale(${motion.currentScale})`;

        if (
          Math.abs(motion.targetY - motion.currentY) > 0.02 ||
          Math.abs(motion.targetRotateX - motion.currentRotateX) > 0.01 ||
          Math.abs(motion.targetRotateY - motion.currentRotateY) > 0.01 ||
          Math.abs(motion.targetRotateZ - motion.currentRotateZ) > 0.01 ||
          Math.abs(motion.targetScale - motion.currentScale) > 0.0001
        ) {
          unsettled = true;
        }
      });

      animationFrame = unsettled ? requestAnimationFrame(renderMotion) : 0;
    };

    const syncMotion = () => {
      trackMotion.currentX = trackMotion.targetX;
      if (desktop.matches) {
        track.style.transform = `translate3d(${trackMotion.currentX}px, 0, 0)`;
      }

      motions.forEach((motion, index) => {
        motion.currentY = motion.targetY;
        motion.currentRotateX = motion.targetRotateX;
        motion.currentRotateY = motion.targetRotateY;
        motion.currentRotateZ = motion.targetRotateZ;
        motion.currentScale = motion.targetScale;
        cards[index].style.transform =
          `translate3d(0, ${motion.currentY}px, 0) ` +
          `rotateX(${motion.currentRotateX}deg) ` +
          `rotateY(${motion.currentRotateY}deg) ` +
          `rotateZ(${motion.currentRotateZ}deg) ` +
          `scale(${motion.currentScale})`;
      });
    };

    const update = () => {
      frame = 0;

      if (reducedMotion.matches) {
        if (animationFrame) cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        track.style.removeProperty("transform");
        cards.forEach((card) => card.style.removeProperty("transform"));
        return;
      }

      if (!desktop.matches) {
        track.style.removeProperty("transform");
        setMobileTargets();
      } else {
        setDesktopTargets();
      }

      previousTime = performance.now();
      if (!animationFrame) {
        animationFrame = requestAnimationFrame(renderMotion);
      }
    };

    const requestUpdate = () => {
      if (!active || frame) return;
      frame = requestAnimationFrame(update);
    };

    const syncMode = () => {
      if (frame) cancelAnimationFrame(frame);
      if (animationFrame) cancelAnimationFrame(animationFrame);
      frame = 0;
      animationFrame = 0;

      if (reducedMotion.matches) {
        track.style.removeProperty("transform");
        cards.forEach((card) => card.style.removeProperty("transform"));
      } else if (desktop.matches) {
        setDesktopTargets();
        syncMotion();
      } else {
        track.style.removeProperty("transform");
        setMobileTargets();
        syncMotion();
      }
    };

    syncMode();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    desktop.addEventListener("change", syncMode);
    reducedMotion.addEventListener("change", syncMode);

    cleanupDifference = () => {
      active = false;
      if (frame) cancelAnimationFrame(frame);
      if (animationFrame) cancelAnimationFrame(animationFrame);
      window.removeEventListener("scroll", requestUpdate);
      window.removeEventListener("resize", requestUpdate);
      desktop.removeEventListener("change", syncMode);
      reducedMotion.removeEventListener("change", syncMode);
      track.style.removeProperty("transform");
      cards.forEach((card) => card.style.removeProperty("transform"));
    };

    document.fonts.ready.then(requestUpdate);
  }

  initDifference();
  document.addEventListener("astro:page-load", initDifference);
  document.addEventListener("astro:before-swap", () => cleanupDifference?.());
</script>

<style>
  .difference-section {
    position: relative;
    min-width: 0;
  }

  .difference-sticky {
    min-width: 0;
  }

  .difference-rails {
    display: none;
  }

  .difference-heading {
    padding-bottom: 2rem;
  }

  .difference-viewport {
    min-width: 0;
    overflow: visible;
    padding: 1rem 1rem 3.5rem;
  }

  .difference-viewport::-webkit-scrollbar {
    display: none;
  }

  .difference-track {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 5rem;
  }

  .difference-card {
    position: relative;
    display: flex;
    width: 85%;
    min-height: 0;
    flex: 0 0 auto;
    flex-direction: column;
    justify-content: flex-start;
    padding: 1.35rem 1.5rem 3.25rem;
    color: var(--color-background);
    background: white;
    will-change: transform;
  }

  .difference-card::after {
    content: "";
    position: absolute;
    right: 1.5rem;
    bottom: 1.25rem;
    left: 1.5rem;
    border-top: 1px solid currentColor;
  }

  .difference-card__title {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.45rem;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.05;
  }

  .difference-card__title strong {
    font-weight: 700;
  }

  .difference-card p {
    max-width: 34ch;
    padding-top: 0.75rem;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.08;
  }

  @media (max-width: 47.999rem) {
    .difference-heading {
      padding-top: 1.5rem;
    }

    .difference-track {
      perspective: 100vw;
    }

    .difference-card {
      transform-origin: center bottom;
      transform-style: preserve-3d;
    }
  }

  @media (min-width: 48rem) {
    .difference-section {
      height: 460vh;
    }

    .difference-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      overflow: hidden;
    }

    .difference-rails {
      position: absolute;
      inset: 0;
      z-index: 0;
      display: block;
      pointer-events: none;
      background-image:
        linear-gradient(to bottom, var(--grid-line-color), var(--grid-line-color)),
        linear-gradient(to bottom, var(--grid-line-color), var(--grid-line-color));
      background-position:
        0 40%,
        0 78%;
      background-repeat: no-repeat;
      background-size: 100% 1px;
    }

    .difference-heading {
      position: relative;
      z-index: 2;
      padding-bottom: 0;
    }

    .difference-viewport {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      overflow: visible;
      z-index: 1;
      padding: 8rem 5vw 0;
      perspective: 120vw;
      perspective-origin: center;
      scroll-snap-type: none;
    }

    .difference-track {
      width: max-content;
      flex-direction: row;
      align-items: center;
      gap: 8vw;
      will-change: transform;
    }

    .difference-card {
      width: 30vw;
      min-width: 19rem;
      max-width: 31rem;
      min-height: clamp(12rem, 17vw, 15.5rem);
      justify-content: center;
      transform-origin: center bottom;
      transform-style: preserve-3d;
      padding: clamp(1.35rem, 2vw, 2rem);
      scroll-snap-align: none;
    }

    .difference-card::after {
      right: clamp(1.35rem, 2vw, 2rem);
      bottom: clamp(1.1rem, 1.4vw, 1.4rem);
      left: clamp(1.35rem, 2vw, 2rem);
    }
  }

  @media (min-width: 48rem) and (prefers-reduced-motion: reduce) {
    .difference-section {
      height: auto;
    }

    .difference-sticky {
      position: relative;
      height: auto;
      overflow: visible;
    }

    .difference-heading {
      padding-bottom: 2rem;
    }

    .difference-rails {
      display: none;
    }

    .difference-viewport {
      position: relative;
      display: block;
      overflow-x: auto;
      padding: 1rem 1rem 3.5rem;
      scroll-snap-type: x mandatory;
    }

    .difference-track {
      gap: 5rem;
      transform: none;
    }

    .difference-card {
      width: min(82vw, 25rem);
      min-width: 0;
      min-height: 13.5rem;
      transform: none;
      scroll-snap-align: center;
    }
  }
</style>
