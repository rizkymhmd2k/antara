---
import SectionHeading from "../ui/SectionHeading.astro";
import { getCollection, getEntry } from "astro:content";

const section = await getEntry("site", "home-process");
const heading = section?.data as { eyebrow: string; title: string };
const items = (await getCollection("process-steps"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section class="process-section container-padding" data-process-section>
  <SectionHeading eyebrow={heading.eyebrow} title={heading.title} />

  <div class="process-grid">
    {
      items.map((item, index) => (
        <article class="step-card" tabindex="0">
          <header class="card-header">
            <span class="card-index">{item.number}</span>
            <span class="card-progress" aria-hidden="true"><i /></span>
            <span class="card-count">0{items.length}</span>
          </header>

          <div class="card-copy">
            <p class="card-kicker caption-text">Step {index + 1}</p>
            <h2>{item.title}</h2>
            <p class="card-body">{item.body}</p>
          </div>

          <div
            class:list={["diagram", `diagram-${item.shape}`]}
            aria-hidden="true"
          >
            <span />
            <span />
            <span />
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .process-section { min-height: 100vh; }

  .process-grid {
    display: flex;
    flex-direction: column;
    border: 1px solid rgb(255 255 255 / 0.35);
  }

  .step-card {
    --parallax-x: 0px;
    --parallax-y: 0px;
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 34rem;
    flex-direction: column;
    overflow: hidden;
    padding: 1rem;
    outline: none;
    background: rgb(0 76 187 / 0.78);
    transition: flex 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .step-card + .step-card { border-top: 1px solid rgb(255 255 255 / 0.35); }

  .step-card::after {
    content: "";
    position: absolute;
    z-index: 4;
    inset: 0;
    pointer-events: none;
    border: 1px solid transparent;
    transition: border-color 300ms ease;
  }

  .step-card:focus-visible::after { border-color: rgb(255 255 255 / 0.95); }

  .card-header {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
  }

  .card-index,
  .card-count { font-variant-numeric: tabular-nums; }
  .card-count { color: rgb(255 255 255 / 0.52); }

  .card-progress {
    height: 1px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.22);
  }

  .card-progress i {
    display: block;
    width: 100%;
    height: 100%;
    background: white;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .step-card:hover .card-progress i,
  .step-card:focus-visible .card-progress i { transform: scaleX(1); }

  .card-copy {
    position: relative;
    z-index: 2;
    width: min(100%, 24rem);
    margin-top: 3.5rem;
  }

  .card-kicker {
    margin-bottom: 0.65rem;
  }

  .card-copy h2 {
    font-size: clamp(3.3rem, 12vw, 5.5rem);
    line-height: 0.82;
    letter-spacing: -0.055em;
  }

  .card-body {
    max-width: 22rem;
    margin-top: 1.4rem;
    color: rgb(255 255 255 / 0.78);
    font-size: 0.98rem;
    line-height: 1.35;
  }

  .diagram {
    position: absolute;
    right: -10%;
    bottom: -12%;
    width: min(21rem, 76vw);
    aspect-ratio: 1;
    transform: translate3d(var(--parallax-x), var(--parallax-y), 0);
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .diagram::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.42rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 2rem rgb(255 255 255 / 0.8);
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity 500ms ease;
  }

  .step-card:hover .diagram::after,
  .step-card:focus-visible .diagram::after { opacity: 1; }

  .diagram span {
    position: absolute;
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.84);
    border-radius: 50%;
  }

  .diagram-clarify span {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .diagram-clarify span:nth-child(1) { width: 100%; }
  .diagram-clarify span:nth-child(2) { width: 70%; }
  .diagram-clarify span:nth-child(3) { width: 38%; }

  .diagram-align span { top: 16%; width: 68%; }
  .diagram-align span:nth-child(1) { left: -8%; }
  .diagram-align span:nth-child(2) { right: -8%; }
  .diagram-align span:nth-child(3) {
    display: none;
  }

  .diagram-evolve span {
    top: 50%;
    left: 50%;
    width: 28%;
    transform: translate(-50%, -50%);
  }

  .diagram.is-visible.diagram-clarify span {
    animation: clarify-breathe 5s ease-in-out infinite;
  }
  .diagram.is-visible.diagram-clarify span:nth-child(2) { animation-delay: 150ms; }
  .diagram.is-visible.diagram-clarify span:nth-child(3) { animation-delay: 300ms; }

  .diagram.is-visible.diagram-align span:nth-child(1) {
    animation: align-left 4.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  .diagram.is-visible.diagram-align span:nth-child(2) {
    animation: align-right 4.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .diagram.is-visible.diagram-evolve span {
    animation: evolve-ripple 3.6s ease-out infinite;
  }
  .diagram.is-visible.diagram-evolve span:nth-child(2) { animation-delay: 1.2s; }
  .diagram.is-visible.diagram-evolve span:nth-child(3) { animation-delay: 2.4s; }

  @keyframes clarify-breathe {
    0%, 100% { opacity: 0.48; filter: blur(2px); }
    35%, 75% { opacity: 1; filter: blur(0); }
  }

  @keyframes align-left {
    0%, 100% { transform: translateX(-12%); opacity: 0.55; }
    50% { transform: translateX(12%); opacity: 1; }
  }

  @keyframes align-right {
    0%, 100% { transform: translateX(12%); opacity: 0.55; }
    50% { transform: translateX(-12%); opacity: 1; }
  }

  @keyframes evolve-ripple {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.2); }
    20% { opacity: 0.9; }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(3.6); }
  }

  @media (min-width: 48rem) {
    .process-grid {
      min-height: min(44rem, 72vh);
      flex-direction: row;
    }

    .step-card {
      min-width: 0;
      min-height: min(44rem, 72vh);
      flex: 1 1 0;
      padding: 1.25rem;
    }

    .step-card + .step-card {
      border-top: 0;
      border-left: 1px solid rgb(255 255 255 / 0.35);
    }

    .process-grid:has(.step-card:hover) .step-card { flex-grow: 0.88; }
    .process-grid:has(.step-card:hover) .step-card:hover {
      flex-grow: 1.24;
    }

    .card-copy { margin-top: clamp(4.5rem, 10vh, 7rem); }

    .card-copy h2 {
      font-size: clamp(3.2rem, 5vw, 6rem);
      white-space: nowrap;
    }

    .card-body {
      max-width: 20rem;
      opacity: 0.74;
      transition: opacity 400ms ease;
    }

    .step-card:hover .card-body,
    .step-card:focus-visible .card-body { opacity: 1; }

    .diagram {
      right: -18%;
      bottom: -13%;
      width: clamp(17rem, 25vw, 30rem);
    }

    .step-card:hover .diagram,
    .step-card:focus-visible .diagram {
      transform: translate3d(var(--parallax-x), var(--parallax-y), 0) scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step-card,
    .card-progress i,
    .diagram { transition: none; }

    .diagram span {
      animation: none !important;
      filter: none !important;
      opacity: 1 !important;
    }

    .diagram-evolve span:nth-child(1) { width: 100%; }
    .diagram-evolve span:nth-child(2) { width: 66%; }
    .diagram-evolve span:nth-child(3) { width: 32%; }
  }
</style>

<script>
  let processCleanup: (() => void) | undefined;

  function initProcess() {
    processCleanup?.();

    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-process-section] .step-card"),
    );
    const diagrams = cards
      .map((card) => card.querySelector<HTMLElement>(".diagram"))
      .filter((diagram): diagram is HTMLElement => Boolean(diagram));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const onPointerMove = (event: PointerEvent) => {
      if (reducedMotion.matches) return;

      const card = event.currentTarget as HTMLElement;
      const bounds = card.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width;
      const y = (event.clientY - bounds.top) / bounds.height;

      card.style.setProperty("--parallax-x", `${(x - 0.5) * 18}px`);
      card.style.setProperty("--parallax-y", `${(y - 0.5) * 18}px`);
    };

    const onPointerLeave = (event: PointerEvent) => {
      const card = event.currentTarget as HTMLElement;
      card.style.setProperty("--parallax-x", "0px");
      card.style.setProperty("--parallax-y", "0px");
    };

    cards.forEach((card) => {
      card.addEventListener("pointermove", onPointerMove);
      card.addEventListener("pointerleave", onPointerLeave);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.3 },
    );

    diagrams.forEach((diagram) => observer.observe(diagram));

    processCleanup = () => {
      observer.disconnect();
      cards.forEach((card) => {
        card.removeEventListener("pointermove", onPointerMove);
        card.removeEventListener("pointerleave", onPointerLeave);
      });
    };
  }

  initProcess();
  document.addEventListener("astro:page-load", initProcess);
</script>
