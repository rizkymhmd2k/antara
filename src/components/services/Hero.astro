---
import Button from "../ui/Button.astro";
import { getEntry } from "astro:content";

const page = await getEntry("site", "services-page");
const data = page?.data as {
  eyebrow: string;
  headline: string;
  subtext: string;
  button: string;
  href: string;
};
---

<section class="hero-padding relative flex h-dvh overflow-hidden ">
  <div class="relative z-10 flex h-full w-full flex-col justify-between ">
    <div aria-hidden="true"></div>

    <div class="flex min-w-0 items-end ">
      <h1 class="max-w-[10.8ch] text-6xl leading-[0.9] tracking-tight [overflow-wrap:anywhere] sm:max-w-6xl sm:text-7xl md:text-8xl">
        {data.headline.split(" ").slice(0, 4).join(" ")}
        <br class="hidden sm:block" />
        <span class="">
          {data.headline.split(" ").slice(4).join(" ").split(/(Forward)/).map((part) =>
            part === "Forward" ? (
              <span class="forward-word" data-forward-word><span class="forward-initial">F</span><span class="forward-rest">orward</span></span>
            ) : part
          )}
        </span>
      </h1>
    </div>

    <div class="grid min-w-0 gap-8 md:grid-cols-3 md:items-end md:gap-8">
      <div class="hidden  pt-4 md:block">
        <p class="caption-text w-full max-w-[12rem]">
          Five services. One continuing advisory relationship.
        </p>
      </div>
      <div class="md:col-span-2 md:ml-auto md:max-w-xl">
        <p class="title-text max-w-[550px] text-white/88">{data.subtext}</p>
        <div class="mt-6">
          <Button
            text={data.button}
            href={data.href}
            trackingEvent="contact_email_click"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  for (const word of document.querySelectorAll<HTMLElement>("[data-forward-word]")) {
    const hero = word.closest("section");
    if (!hero) continue;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;

    const render = () => {
      frame = 0;
      // Reach full stretch while the headline is still visible.
      const progress = reducedMotion.matches ? 0 : Math.min(1, Math.max(0,
        -hero.getBoundingClientRect().top / (hero.offsetHeight * 0.35),
      ));
      word.style.setProperty("--forward-stretch", String(1 + progress * 0.45));
      word.style.setProperty("--forward-compression", String(1 - progress * 0.09));
    };

    const scheduleRender = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };

    window.addEventListener("scroll", scheduleRender, { passive: true });
    window.addEventListener("resize", scheduleRender);
    reducedMotion.addEventListener("change", scheduleRender);
    scheduleRender();

    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("resize", scheduleRender);
      window.removeEventListener("scroll", scheduleRender);
      reducedMotion.removeEventListener("change", scheduleRender);
      cancelAnimationFrame(frame);
    }, { once: true });
  }
</script>

<style>
  .forward-word {
    display: inline-flex;
    white-space: nowrap;
  }

  /* Transforms redistribute space without changing the headline's layout. */
  .forward-initial,
  .forward-rest {
    display: inline-block;
  }

  .forward-initial {
    transform-origin: left center;
    transform: scaleX(var(--forward-stretch, 1));
  }

  .forward-rest {
    transform-origin: right center;
    transform: scaleX(var(--forward-compression, 1));
  }

  @media (prefers-reduced-motion: reduce) {
    .forward-initial,
    .forward-rest {
      transform: none !important;
    }
  }
</style>
