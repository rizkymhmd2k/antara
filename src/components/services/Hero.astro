---
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";
import ScrollLine from "../ui/ScrollLine.astro";
import scrollLineUrl from "../../assets/lines/scroll-line-2.svg?url";
import { getEntry } from "astro:content";

const page = await getEntry("site", "services-page");
const data = page?.data as {
  eyebrow: string;
  headline: string;
  subtext: string;
  button: string;
  href: string;
};
---

<section class="hero-padding relative flex h-dvh overflow-hidden ">
  <!-- <ScrollLine
    src={scrollLineUrl}
    mobileEndOffset={0.86}
    class="pointer-events-none absolute inset-x-0 top-[16%] h-[82vh] w-full opacity-80 sm:top-[10%] sm:h-[92vh]"
    imgClass="h-full w-full max-w-none"
  /> -->

  <!-- <div
    aria-hidden="true"
    class="absolute bottom-0 left-4 right-4 z-0 h-px bg-white/35 sm:left-8 sm:right-8"
  >
  </div> -->

  <div class="relative z-10 flex h-full w-full flex-col justify-between ">
    <div class="grid min-w-0 gap-8 md:grid-cols-3 md:gap-8 ">
      <!-- <Eyebrow text={data.eyebrow} /> -->
      <p class="caption-text w-full max-w-[20rem] md:col-start-3">
        Planning, investment, reporting, legacy, and liquidity held in one field
        of view.
      </p>
    </div>

    <div class="flex min-w-0 items-end ">
      <h1 class="max-w-[10.8ch] text-6xl leading-[0.9] tracking-tight [overflow-wrap:anywhere] sm:max-w-6xl sm:text-7xl md:text-8xl">
        {data.headline.split(" ").slice(0, 4).join(" ")}
        <br class="hidden sm:block" />
        <span class="">
          {data.headline.split(" ").slice(4).join(" ")}
        </span>
      </h1>
    </div>

    <div class="grid min-w-0 gap-8 md:grid-cols-3 md:items-end md:gap-8">
      <div class="hidden  pt-4 md:block">
        <p class="caption-text w-full max-w-[12rem]">
          Five services. One continuing advisory relationship.
        </p>
      </div>
      <div class="md:col-span-2 md:ml-auto md:max-w-xl">
        <p class="title-text max-w-[550px] text-white/88">{data.subtext}</p>
        <div class="mt-6">
          <Button
            text={data.button}
            href={data.href}
            trackingEvent="contact_email_click"
          />
        </div>
      </div>
    </div>
  </div>
</section>
