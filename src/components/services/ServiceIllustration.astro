---
interface Props { index: number }
const { index } = Astro.props;

function arc(radius: number, start: number, end: number) {
  const at = (angle: number) => {
    const radians = (angle * Math.PI) / 180;
    return `${180 + radius * Math.cos(radians)} ${170 + radius * Math.sin(radians)}`;
  };
  return `M${at(start)} A${radius} ${radius} 0 ${end - start > 180 ? 1 : 0} 1 ${at(end)}`;
}
---

<div class="service-illustration" aria-hidden="true">
  <svg viewBox="0 0 360 360" fill="none" focusable="false">
    {index === 0 && (
      <>
        <!-- A continuous plan connects today's decisions to future milestones. -->
        <path class="quiet" d="M42 260H318" />
        {[70, 143, 216, 289].map((x) => <path class="quiet" d={`M${x} 255v10`} />)}
        {[0, 1, 2, 3, 4].map((i) => (
          <path class="plan-route" style={`--delay: ${i * 100}ms`} pathLength="1"
            d={`M42 ${226 + i * 7} C99 ${226 + i * 7} 100 ${154 + i * 7} 158 ${154 + i * 7} S239 ${81 + i * 7} 304 ${81 + i * 7}`} />
        ))}
        <path class="quiet" d="M70 223V250 M143 164V250 M216 138V250 M289 84V250" />
        <g class="milestones">
          <circle cx="70" cy="223" r="4" />
          <circle cx="143" cy="164" r="4" />
          <circle cx="216" cy="138" r="4" />
          <circle cx="289" cy="84" r="4" />
        </g>
      </>
    )}

    {index === 1 && (
      <>
        <!-- Three distinct allocations form one portfolio; no return forecast. -->
        <circle class="quiet" cx="180" cy="170" r="44" />
        {[[ -88, 66 ], [ 72, 193 ], [ 199, 266 ]].map(([start, end], sector) => (
          <g class="allocation" style={`--turn: ${(sector - 1) * 26}deg; --delay: ${sector * 180}ms`}>
            {[60, 69, 78, 87, 96, 105].map((radius) => <path d={arc(radius, start, end)} />)}
          </g>
        ))}
        <path class="quiet" d="M172 170H188 M180 162V178" />
      </>
    )}

    {index === 2 && (
      <>
        <!-- Separate records settle into a single, readable ledger. -->
        <g class="record record-back" style="--x: -38px; --y: -12px; --delay: 0ms">
          <path class="quiet" d="M240 66V46H80V258H100" />
          <path class="quiet" d="M104 82H132 M104 94H122" />
        </g>
        <g class="record" style="--x: 38px; --y: 12px; --delay: 100ms">
          <path class="quiet" d="M260 86V66H100V278H120" />
        </g>
        <g class="record" style="--x: 0px; --y: 24px; --delay: 200ms">
          <path d="M120 86H280V298H120Z" />
          <path d="M140 112H200 M140 120H172" />
          <path class="quiet" d="M140 142H260 M220 156V246" />
          {[162, 180, 198, 216, 234].map((y, i) => (
            <path class="ledger-row" style={`--delay: ${400 + i * 110}ms`} d={`M140 ${y}H${180 + (i % 3) * 10} M238 ${y}H260`} />
          ))}
          <path d="M140 258H260 M230 274H260" />
        </g>
      </>
    )}

    {index === 3 && (
      <>
        <!-- One generation supports two, then four: continuity through family. -->
        <path class="family-branch" pathLength="1" d="M180 274V228 C180 194 105 205 105 164" />
        <path class="family-branch" pathLength="1" d="M180 228 C180 194 255 205 255 164" />
        {[{x:105, left:62, right:148}, {x:255, left:212, right:298}].map(({x,left,right}) => (
          <>
            <path class="family-branch" style="--delay: 450ms" pathLength="1" d={`M${x} 148V133 C${x} 108 ${left} 116 ${left} 83`} />
            <path class="family-branch" style="--delay: 450ms" pathLength="1" d={`M${x} 133 C${x} 108 ${right} 116 ${right} 83`} />
          </>
        ))}
        <circle cx="180" cy="282" r="8" />
        {[105,255].map((x) => <circle cx={x} cy="156" r="8" />)}
        {[62,148,212,298].map((x) => <circle class="family-member" cx={x} cy="75" r="8" />)}
        <path class="quiet" d="M156 306H204" />
      </>
    )}

    {index === 4 && (
      <>
        <!-- An asset stays in place while credit makes cash available. -->
        <g class="secured-asset">
          <path d="M42 166L100 118L158 166 M54 156V248H146V156" />
          <path class="quiet" d="M67 155L100 128L133 155" />
          <path class="quiet" d="M38 258H162" />
        </g>

        <path class="quiet" d="M133 109C174 68 237 72 266 116" />
        <path class="credit-release" pathLength="1" d="M133 109C174 68 237 72 266 116" />
        <path d="M255 111L266 116L267 104" />

        <g class="available-cash">
          <path class="quiet" d="M219 150V138H319V198H307 M207 162V150H307V210H295" />
          <path d="M195 162H295V222H195Z" />
          <path class="quiet" d="M211 172H279 M211 212H279" />
          <circle cx="245" cy="192" r="13" />
          <path d="M210 189V195 M280 189V195" />
          <path class="quiet" d="M245 185V199 M241 188H247C251 188 251 192 247 192H243C239 192 239 196 243 196H249" />
        </g>

        <path class="quiet" d="M261 246C222 291 167 289 141 272" />
        <path class="quiet" d="M145 283L141 272L153 271" />
      </>
    )}
  </svg>
</div>

<style>
  .service-illustration { width: 100%; max-width: 25rem; margin-inline: auto; }
  svg { display: block; width: 100%; height: auto; }
  path, circle {
    stroke: rgb(255 255 255 / 0.72);
    stroke-width: 0.75;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .quiet { stroke: rgb(255 255 255 / 0.25); }
  .milestones circle { fill: var(--color-background); }
  .credit-release { stroke: rgb(255 255 255 / 0.9); }

  /* Motion explains the service once; the complete illustration is the fallback. */
  @media (prefers-reduced-motion: no-preference) {
    [data-revealed] .plan-route,
    [data-revealed] .family-branch {
      stroke-dasharray: 1;
      animation: connect 1800ms cubic-bezier(0.45, 0, 0.2, 1) var(--delay, 0ms) both;
    }
    [data-revealed] .allocation {
      transform-origin: 180px 170px;
      animation: allocate 2000ms cubic-bezier(0.16, 1, 0.3, 1) var(--delay) both;
    }
    [data-revealed] .record {
      animation: consolidate 1800ms cubic-bezier(0.16, 1, 0.3, 1) var(--delay) both;
    }
    [data-revealed] .ledger-row { animation: clarify 1000ms ease var(--delay) both; }
    [data-revealed] .family-member { animation: clarify 1000ms ease 1000ms both; }
    [data-revealed] .credit-release {
      stroke-dasharray: 1;
      animation: connect 1500ms cubic-bezier(0.45, 0, 0.2, 1) both;
    }
    [data-revealed] .available-cash {
      animation: release-cash 1600ms cubic-bezier(0.16, 1, 0.3, 1) 650ms both;
    }

    @keyframes connect { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
    @keyframes allocate { from { transform: rotate(var(--turn)); opacity: 0.25; } to { transform: rotate(0); opacity: 1; } }
    @keyframes consolidate { from { transform: translate(var(--x), var(--y)); } to { transform: translate(0, 0); } }
    @keyframes clarify { from { opacity: 0.15; } to { opacity: 1; } }
    @keyframes release-cash {
      from { opacity: 0.2; transform: translateX(-20px); }
      to { opacity: 1; transform: translateX(0); }
    }
  }
</style>
