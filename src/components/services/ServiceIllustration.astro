---
interface Props { index: number }
const { index } = Astro.props;

type Point = [number, number, number];
type Solid = {
  x: number;
  y: number;
  z: number;
  width: number;
  depth: number;
  height: number;
  detail?: "plan" | "dots" | "ledger" | "reserve";
  motion?: "lift" | "slide";
};

// All five objects share the same projection and edge treatment.
function project([x, y, z]: Point) {
  return `${180 + (x - y) * 0.86},${218 + (x + y) * 0.43 - z}`;
}
function line(points: Point[], close = false) {
  return `${points.map((point, i) => `${i ? "L" : "M"}${project(point)}`).join(" ")}${close ? " Z" : ""}`;
}
function faces({ x, y, z, width: w, depth: d, height: h }: Solid) {
  return {
    left: line([[x, y + d, z + h], [x + w, y + d, z + h], [x + w, y + d, z], [x, y + d, z]], true),
    right: line([[x + w, y, z + h], [x + w, y + d, z + h], [x + w, y + d, z], [x + w, y, z]], true),
    top: line([[x, y, z + h], [x + w, y, z + h], [x + w, y + d, z + h], [x, y + d, z + h]], true),
  };
}

const foundation: Solid = { x: -84, y: -84, z: 0, width: 168, depth: 168, height: 8 };
const sculptures: Solid[][] = [
  // A living plan: a stable foundation and a separated decision layer.
  [
    ...[0, 14, 28, 42].map((z) => ({ ...foundation, z, motion: "lift" as const })),
    { ...foundation, z: 84, detail: "plan", motion: "lift" },
  ],
  // Different portfolio assignments, all considered on a common base.
  [
    foundation,
    { x: -70, y: -70, z: 8, width: 62, depth: 62, height: 98, detail: "dots", motion: "lift" },
    { x: 8, y: -70, z: 8, width: 62, depth: 62, height: 55, detail: "dots", motion: "lift" },
    { x: -70, y: 8, z: 8, width: 62, depth: 62, height: 68, detail: "dots", motion: "lift" },
    { x: 8, y: 8, z: 8, width: 62, depth: 62, height: 32, detail: "dots", motion: "lift" },
  ],
  // Separate records resolve into a single readable overview.
  [
    { x: -76, y: -58, z: 0, width: 152, depth: 5, height: 142, motion: "lift" },
    { x: -76, y: -28, z: 0, width: 152, depth: 5, height: 130, motion: "lift" },
    { x: -76, y: 2, z: 0, width: 152, depth: 5, height: 118, motion: "lift" },
    { x: -76, y: 32, z: 0, width: 152, depth: 5, height: 106, detail: "ledger", motion: "lift" },
  ],
  // Connected people and structures, supported by one foundation.
  [
    foundation,
    { x: -24, y: -72, z: 8, width: 48, depth: 48, height: 87, detail: "dots", motion: "lift" },
    { x: -72, y: 0, z: 8, width: 48, depth: 48, height: 44, detail: "dots", motion: "lift" },
    { x: 24, y: 0, z: 8, width: 48, depth: 48, height: 44, detail: "dots", motion: "lift" },
    { x: -24, y: 48, z: 8, width: 48, depth: 28, height: 16, motion: "lift" },
  ],
  // An accessible layer extends while the core structure stays anchored.
  [
    { x: -70, y: -70, z: 0, width: 140, depth: 140, height: 12 },
    { x: -56, y: -16, z: 23, width: 112, depth: 138, height: 7, detail: "reserve", motion: "slide" },
    { x: -70, y: -70, z: 42, width: 140, depth: 140, height: 67, detail: "dots", motion: "lift" },
  ],
];
const solids = sculptures[index] ?? [];
---

<div class="service-illustration" aria-hidden="true">
  <svg viewBox="0 0 360 360" fill="none" focusable="false">
    <path class="registration" d="M18 43H34 M18 43V59 M326 317H342 M342 301V317" />

    {index === 0 && (
      <g class="guides">
        {[[-84, -84], [84, -84], [-84, 84], [84, 84]].map(([x, y]) => (
          <path d={line([[x, y, 50], [x, y, 84]])} />
        ))}
      </g>
    )}

    <g transform={index === 2 ? "translate(0 24)" : undefined}>
    {solids.map((solid, i) => {
      const face = faces(solid);
      const { x, y, z, width: w, depth: d, height: h } = solid;
      const top = z + h;
      return (
        <g class:list={["solid", solid.motion]} style={`--delay: ${i * 100}ms`}>
          <path class="face face-left" d={face.left} />
          <path class="face face-right" d={face.right} />
          <path class="face face-top" d={face.top} />

          {solid.detail === "plan" && (
            <g class="surface-detail">
              <path class="quiet" d={line([[-56, -56, top], [56, -56, top], [56, 56, top], [-56, 56, top]], true)} />
              <path d={line([[-40, 28, top], [-12, 28, top], [-12, -12, top], [32, -12, top], [32, -38, top]])} />
              {[[-40, 28], [-12, -12], [32, -38]].map(([px, py]) => (
                <path class="node" d={line([[px - 3, py - 3, top], [px + 3, py - 3, top], [px + 3, py + 3, top], [px - 3, py + 3, top]], true)} />
              ))}
            </g>
          )}

          {solid.detail === "dots" && (
            <g class="surface-detail quiet">
              {[0, 1, 2].flatMap((row) => [0, 1, 2].map((col) => (
                <path d={line([[x + w / 2 - 6 + col * 5, y + d / 2 - 6 + row * 5, top], [x + w / 2 - 4 + col * 5, y + d / 2 - 6 + row * 5, top]])} />
              )))}
            </g>
          )}

          {solid.detail === "ledger" && (
            <g class="surface-detail">
              <path d={line([[x + 18, y + d, top - 18], [x + 64, y + d, top - 18]])} />
              <path class="quiet" d={line([[x + 18, y + d, top - 30], [x + w - 18, y + d, top - 30]])} />
              {[0, 1, 2, 3].map((row) => (
                <g class="quiet">
                  <path d={line([[x + 18, y + d, top - 43 - row * 12], [x + 60 + (row % 2) * 17, y + d, top - 43 - row * 12]])} />
                  <path d={line([[x + w - 38, y + d, top - 43 - row * 12], [x + w - 18, y + d, top - 43 - row * 12]])} />
                </g>
              ))}
              <path d={line([[x + 18, y + d, 13], [x + w - 18, y + d, 13]])} />
            </g>
          )}

          {index === 3 && i === 0 && (
            <g class="surface-detail quiet">
              <path d={line([[0, -24, top], [0, 24, top], [-48, 24, top]])} />
              <path d={line([[0, 24, top], [48, 24, top]])} />
              <path d={line([[0, 24, top], [0, 64, top]])} />
            </g>
          )}

          {solid.detail === "reserve" && (
            <g class="surface-detail quiet">
              {[88, 98, 108].map((py) => <path d={line([[-36, py, top], [36, py, top]])} />)}
            </g>
          )}
        </g>
      );
    })}
    </g>
  </svg>
</div>

<style>
  .service-illustration { width: 100%; max-width: 25rem; margin-inline: auto; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  path {
    stroke: rgb(255 255 255 / 0.55);
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .registration { stroke: rgb(255 255 255 / 0.18); }
  .face { fill: var(--color-background); }
  .face-left { fill: color-mix(in srgb, var(--color-background), black 9%); stroke: rgb(255 255 255 / 0.35); }
  .face-right { fill: color-mix(in srgb, var(--color-background), black 17%); stroke: rgb(255 255 255 / 0.4); }
  .face-top { fill: color-mix(in srgb, var(--color-background), white 2%); }
  .quiet, .quiet path { stroke: rgb(255 255 255 / 0.28); }
  .guides path { stroke: rgb(255 255 255 / 0.22); stroke-dasharray: 2 4; }
  .node { fill: var(--color-background); }

  /* Keep a complete static illustration when motion is disabled or JS is absent. */
  @media (prefers-reduced-motion: no-preference) {
    [data-revealed] .lift {
      animation: assemble 1600ms cubic-bezier(0.16, 1, 0.3, 1) var(--delay, 0ms) both;
    }
    [data-revealed] .slide {
      animation: extend 1800ms cubic-bezier(0.16, 1, 0.3, 1) 250ms both;
    }
    @keyframes assemble {
      from { transform: translateY(-16px); }
      to { transform: translateY(0); }
    }
    @keyframes extend {
      from { transform: translate(24px, -12px); }
      to { transform: translate(0, 0); }
    }
  }
</style>
