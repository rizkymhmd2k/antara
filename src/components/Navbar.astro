---
import logoUrl from "../assets/icon/AntaraSVG.svg?url";
import Button from "./ui/Button.astro";

const navItems = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Services", href: "/services" },
];

const contactItem = { label: "Contact", href: "/contact" };
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const textAnimation =
  "block transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-full";
---

<header
  class="fixed inset-x-0 top-0 z-40 bg-transparent"
  data-navbar-shell
>
  <nav
    class="flex min-h-20 items-center justify-between gap-6 px-4 py-4 sm:min-h-24 sm:px-8 md:grid md:min-h-0 md:grid-cols-[1fr_auto_1fr] md:py-[0.825rem]"
    aria-label="Primary navigation"
    data-navbar
  >
    <a
      href="/"
      class="relative z-0 inline-flex shrink-0 self-center items-center rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      aria-label="Antara Private Wealth home"
    >
      <img
        src={logoUrl}
        alt="Antara Private Wealth"
        width="1213"
        height="260"
        decoding="async"
        class="block h-auto w-24 sm:w-28 md:w-[5.7rem] lg:w-[6.7rem]"
      />
    </a>

    <div
      class="hidden items-stretch gap-[0.1375rem] rounded-sm border border-white/10 bg-black/25 p-[0.1375rem] shadow-[0_0.5rem_2rem_rgb(0_0_0/0.08)] backdrop-blur-md md:flex"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? "page" : undefined}
            class:list={[
              "group flex min-h-[2.2rem] items-center rounded-[0.2rem] px-[0.825rem] text-[0.825rem] leading-none transition-colors duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white",
              currentPath === item.href
                ? "bg-white text-background"
                : "text-white/80 hover:bg-white/10 hover:text-white",
            ]}
          >
            <span class="relative inline-block overflow-hidden">
              <span class={textAnimation}>{item.label}</span>
              <span
                aria-hidden="true"
                class={`absolute left-0 top-full ${textAnimation}`}
              >
                {item.label}
              </span>
            </span>
          </a>
        ))
      }
    </div>

    <div class="hidden justify-self-end md:block">
      <Button
        text={contactItem.label}
        href={contactItem.href}
        compact
        ariaCurrent={currentPath === contactItem.href ? "page" : undefined}
      />
    </div>

    <button
      type="button"
      class="relative z-20 inline-flex size-12 items-center justify-center rounded-sm border border-white/20 bg-white/15 text-white backdrop-blur-md transition-transform duration-200 ease-out active:scale-[0.97] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white md:hidden"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="sr-only">Open menu</span>

      <span aria-hidden="true" class="relative block h-4 w-5">
        <span class="mobile-menu-line" data-menu-line></span>
        <span class="mobile-menu-line" data-menu-line></span>
      </span>
    </button>
  </nav>

<div
  id="mobile-menu"
  class="pointer-events-none absolute inset-x-0 top-0 h-dvh overflow-hidden md:hidden"
  aria-hidden="true"
  inert
  data-menu
>
  <div
    class="absolute inset-0 z-0 bg-black/30 opacity-0 transition-opacity duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
    data-menu-scrim
  ></div>

  <div
    class="invisible absolute left-4 right-4 top-4 z-10 overflow-hidden rounded-lg border border-white/15 bg-black/30 text-white shadow-[0_1.5rem_4rem_rgb(0_0_0/0.2)] backdrop-blur-xl sm:left-8 sm:right-8 sm:top-6"
    data-menu-panel
  >
    <nav
      class="flex flex-col px-5 pb-3 sm:px-7 sm:pb-4"
      aria-label="Mobile navigation"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? "page" : undefined}
            class="group py-3.5 text-xl leading-none tracking-tight text-white/90 transition-colors duration-300 first:pr-16 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:py-4 sm:text-2xl"
            data-menu-link
          >
            <span class="relative inline-block overflow-hidden">
              <span class={textAnimation}>{item.label}</span>
              <span
                aria-hidden="true"
                class={`absolute left-0 top-full ${textAnimation}`}
              >
                {item.label}
              </span>
            </span>
          </a>
        ))
      }

      <div class="my-1 h-px bg-white/20" aria-hidden="true"></div>

      <a
        href={contactItem.href}
        aria-current={currentPath === contactItem.href ? "page" : undefined}
        class="group flex items-center justify-between py-3.5 text-xl leading-none tracking-tight text-white/90 transition-colors duration-300 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:py-4 sm:text-2xl"
        data-menu-link
      >
        <span class="relative inline-block overflow-hidden">
          <span class={textAnimation}>{contactItem.label}</span>
          <span
            aria-hidden="true"
            class={`absolute left-0 top-full ${textAnimation}`}
          >
            {contactItem.label}
          </span>
        </span>
        <span aria-hidden="true" class="text-lg opacity-70">⌄</span>
      </a>
    </nav>
  </div>
</div>
</header>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }

  [data-menu-panel] {
    clip-path: inset(0 0 100% 100% round 0.5rem);
    transition: clip-path 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-menu][aria-hidden="false"] [data-menu-panel] {
    clip-path: inset(0 0 0 0 round 0.5rem);
  }

  .mobile-menu-line {
    position: absolute;
    left: 50%;
    height: 1px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition:
      top 500ms cubic-bezier(0.22, 1, 0.36, 1),
      width 500ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-menu-line:nth-child(1) { top: 30%; width: 1.25rem; }
  .mobile-menu-line:nth-child(2) { top: 70%; width: 1.25rem; }

  [data-menu-toggle][aria-expanded="true"] .mobile-menu-line {
    top: 50%;
  }

  [data-menu-toggle][aria-expanded="true"] .mobile-menu-line:nth-child(1) {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  [data-menu-toggle][aria-expanded="true"] .mobile-menu-line:nth-child(2) {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-menu-panel],
    .mobile-menu-line {
      transition: none;
    }
  }
</style>

<script>
  const initNavbar = () => {
    const nav = document.querySelector<HTMLElement>("[data-navbar]");
    const shell = document.querySelector<HTMLElement>("[data-navbar-shell]");

    if (!nav || nav.dataset.ready) return;

    nav.dataset.ready = "true";

    const toggle = nav.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = document.querySelector<HTMLElement>("[data-menu]");
    const scrim = document.querySelector<HTMLElement>("[data-menu-scrim]");
    const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
    const links =
      document.querySelectorAll<HTMLAnchorElement>("[data-menu-link]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const controller = new AbortController();

    if (!shell || !toggle || !menu || !scrim || !panel) return;

    const syncNavHeight = () => {
      document.documentElement.style.setProperty(
        "--nav-h",
        `${shell.offsetHeight}px`,
      );
    };

    syncNavHeight();

    window.addEventListener("resize", syncNavHeight, {
      passive: true,
      signal: controller.signal,
    });

    let hidePanelTimer: number | undefined;

    const setMenu = (isOpen: boolean) => {
      if (hidePanelTimer !== undefined) {
        window.clearTimeout(hidePanelTimer);
        hidePanelTimer = undefined;
      }

      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute(
        "aria-label",
        isOpen ? "Close menu" : "Open menu",
      );

      menu.setAttribute("aria-hidden", String(!isOpen));
      menu.inert = !isOpen;
      menu.classList.toggle("pointer-events-none", !isOpen);

      scrim.classList.toggle("opacity-0", !isOpen);
      scrim.classList.toggle("opacity-100", isOpen);

      if (isOpen) {
        panel.classList.remove("invisible");
        panel.classList.add("visible");
      }

      if (!isOpen) {
        hidePanelTimer = window.setTimeout(() => {
          hidePanelTimer = undefined;
          if (toggle.getAttribute("aria-expanded") === "true") return;
          panel.classList.add("invisible");
          panel.classList.remove("visible");
        }, reduceMotion.matches ? 0 : 550);
      }

      if (isOpen) {
        links[0]?.focus({ preventScroll: true });
      } else if (menu.contains(document.activeElement)) {
        toggle.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener(
      "click",
      () => {
        const isOpen =
          toggle.getAttribute("aria-expanded") === "true";

        setMenu(!isOpen);
      },
      { signal: controller.signal },
    );

    scrim.addEventListener(
      "click",
      () => setMenu(false),
      { signal: controller.signal },
    );

    links.forEach((link) =>
      link.addEventListener(
        "click",
        () => setMenu(false),
        { signal: controller.signal },
      ),
    );

    document.addEventListener(
      "astro:before-preparation",
      () => setMenu(false),
      { signal: controller.signal },
    );

    document.addEventListener(
      "astro:before-swap",
      () => controller.abort(),
      {
        once: true,
        signal: controller.signal,
      },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        const isOpen =
          toggle.getAttribute("aria-expanded") === "true";

        if (event.key === "Escape") {
          setMenu(false);
        }

        if (!isOpen || event.key !== "Tab") return;

        const focusable = [
          ...menu.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          ),
          toggle,
        ];

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (!first || !last) return;

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (
          !event.shiftKey &&
          document.activeElement === last
        ) {
          event.preventDefault();
          first.focus();
        }
      },
      { signal: controller.signal },
    );

    if (reduceMotion.matches) {
      scrim.classList.remove("transition-opacity");
    }

    setMenu(false);
  };

  initNavbar();
  document.addEventListener("astro:page-load", initNavbar);
</script>
